@implements IDisposable
@inject ThemeService Theme
@inject AuthSessionService Auth

<MudThemeProvider Theme="@Theme.MudTheme" IsDarkMode="@Theme.Current.Dark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@if (!_startupReady)
{
    <div class="fx-splash">
        <div class="fx-splash-logo">Fenrix<span>CloudBudget</span></div>
        <div class="fx-splash-tag">Preparing your FinOps workspace…</div>
        <div class="fx-splash-spinner"></div>
    </div>
}
else if (!Auth.IsAuthenticated)
{
    <Login />
}
else
{
    <Router AppAssembly="@typeof(Routes).Assembly">
        <Found Context="routeData">
            <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(MainLayout)">
                <div class="fx-card fx-empty-state">
                    <div class="fx-empty-orbit"><MudIcon Icon="@Icons.Material.Filled.ExploreOff" /></div>
                    <h1 class="fx-page-title">Page not found</h1>
                    <p class="fx-page-sub">That route drifted outside the Fenrix workspace.</p>
                    <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary">Return home</MudButton>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
}

@code {
    private bool _startupReady;

    protected override async Task OnInitializedAsync()
    {
        Theme.Changed += OnStateChanged;
        Auth.Changed += OnStateChanged;

        // Keep the branded loading state visible long enough to read and perceive.
        await Task.Delay(TimeSpan.FromSeconds(1));
        _startupReady = true;
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Theme.Changed -= OnStateChanged;
        Auth.Changed -= OnStateChanged;
    }
}
