@page "/projects"
@inject IDbContextFactory<AppDbContext> DbFactory
@inject CloudConnectionService Connections
@inject ISnackbar Snackbar

<section class="fx-page-header">
    <div class="fx-page-heading">
        <div class="fx-eyebrow">Cross-cloud workspaces</div>
        <h1 class="fx-page-title">Projects</h1>
        <p class="fx-page-sub">Group cloud services across providers into client/project buckets.</p>
    </div>
    <MudButton Class="fx-page-action" Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => Edit(new Project()))">
        New project
    </MudButton>
</section>

<div class="fx-tiles">
    @foreach (var p in _projects)
    {
        <button type="button" class="fx-tile fx-project-tile" @onclick="@(() => Edit(p))">
            <div class="fx-tile-title">@p.Name</div>
            <div class="fx-project-client">@(p.Client?.Name ?? "No client")</div>
            <div class="fx-chip-row">
                @foreach (var prov in p.Services.Select(s => s.Provider).Distinct())
                {
                    <span class="fx-chip @prov.ToString().ToLower()">@ProviderLabel(prov)</span>
                }
            </div>
            <div class="fx-tile-stat fx-project-spend">
                @p.Services.Sum(s => s.EstimatedCost).ToString("C0") <small>/mo est. (@p.Currency)</small>
            </div>
            @if (p.Budgets.Any(b => b.IsEnabled))
            {
                <div class="fx-project-budget">
                    Budget: @p.Budgets.Where(b => b.IsEnabled).Sum(b => b.Amount).ToString("C0") /@(p.Budgets.First(b => b.IsEnabled).Period.ToString().ToLower())
                </div>
            }
        </button>
    }
    @if (_projects.Count == 0) { <Empty Text="No projects yet." /> }
</div>

@if (_editing is not null)
{
    <AppModal Title="@(_editing.Id == 0 ? "Create project" : "Edit project")"
              Width="workspace"
              OnCancel="CloseEditor">
        <ChildContent>
            <div class="fx-project-editor">
                <header class="fx-project-editor-summary">
                    <div class="fx-project-editor-mark">
                        <MudIcon Icon="@Icons.Material.Filled.FolderOpen" />
                    </div>
                    <div class="fx-project-editor-copy">
                        <span class="fx-project-editor-kicker">@(_editing.Id == 0 ? "New workspace" : "Project workspace")</span>
                        <strong>@ProjectDisplayName</strong>
                        <span>@ProjectSummary</span>
                    </div>
                    <div class="fx-project-editor-stats">
                        <div><strong>@ManualServiceCount</strong><span>manual</span></div>
                        <div><strong>@ConnectedServiceCount</strong><span>synced</span></div>
                        <div><strong>@_editing.Budgets.Count</strong><span>budgets</span></div>
                        <span class="fx-project-status @StatusClass(_editing.Status)">@_editing.Status</span>
                    </div>
                </header>

                <nav class="fx-project-editor-nav" aria-label="Project editor sections">
                    <button type="button" class="@SectionClass(ProjectEditorSection.Basics)"
                            @onclick="@(() => OpenSection(ProjectEditorSection.Basics))">
                        <MudIcon Icon="@Icons.Material.Filled.Tune" Size="Size.Small" />
                        <span><strong>Basics</strong><small>Name, client and status</small></span>
                        <b>01</b>
                    </button>
                    <button type="button" class="@SectionClass(ProjectEditorSection.Services)"
                            @onclick="@(() => OpenSection(ProjectEditorSection.Services))">
                        <MudIcon Icon="@Icons.Material.Filled.CloudQueue" Size="Size.Small" />
                        <span><strong>Services</strong><small>Manual and synced costs</small></span>
                        <b>02</b>
                    </button>
                    <button type="button" class="@SectionClass(ProjectEditorSection.Budgets)"
                            @onclick="@(() => OpenSection(ProjectEditorSection.Budgets))">
                        <MudIcon Icon="@Icons.Material.Filled.Shield" Size="Size.Small" />
                        <span><strong>Budgets</strong><small>Caps and alert levels</small></span>
                        <b>03</b>
                    </button>
                    <button type="button" class="@SectionClass(ProjectEditorSection.CloudResources)"
                            @onclick="@(() => OpenSection(ProjectEditorSection.CloudResources))">
                        <MudIcon Icon="@Icons.Material.Filled.CloudSync" Size="Size.Small" />
                        <span><strong>Cloud resources</strong><small>Discover existing services</small></span>
                        <b>04</b>
                    </button>
                </nav>

                <main class="fx-project-editor-content">
                    @if (_editorSection == ProjectEditorSection.Basics)
                    {
                        <section class="fx-editor-section">
                            <div class="fx-editor-section-head">
                                <div>
                                    <span>Project identity</span>
                                    <h3>Start with the essentials</h3>
                                    <p>Keep the project easy to recognise in reports and dashboards.</p>
                                </div>
                                <span class="fx-editor-step">Step 1 of 4</span>
                            </div>

                            <div class="fx-editor-surface fx-editor-form-grid">
                                <MudTextField @bind-Value="_editing.Name" Label="Project name *" Required="true"
                                              Variant="Variant.Outlined" Class="fx-editor-span-2" />
                                <MudTextField @bind-Value="_editing.Description" Label="Description" Lines="3"
                                              Variant="Variant.Outlined" Class="fx-editor-span-2" />
                                <MudSelect T="int?" @bind-Value="_editing.ClientId" Label="Client" Clearable="true"
                                           Variant="Variant.Outlined">
                                    @foreach (var c in _clients)
                                    {
                                        <MudSelectItem T="int?" Value="@c.Id">@c.Name</MudSelectItem>
                                    }
                                </MudSelect>
                                <MudSelect T="string" @bind-Value="_editing.Currency" Label="Reporting currency"
                                           Variant="Variant.Outlined">
                                    @foreach (var cur in Currencies)
                                    {
                                        <MudSelectItem Value="@cur">@cur</MudSelectItem>
                                    }
                                </MudSelect>
                                <MudSelect T="ProjectStatus" @bind-Value="_editing.Status" Label="Project status"
                                           Variant="Variant.Outlined">
                                    <MudSelectItem Value="ProjectStatus.Active">Active</MudSelectItem>
                                    <MudSelectItem Value="ProjectStatus.Paused">Paused</MudSelectItem>
                                    <MudSelectItem Value="ProjectStatus.Archived">Archived</MudSelectItem>
                                </MudSelect>
                                <div class="fx-editor-field-note">
                                    <MudIcon Icon="@Icons.Material.Filled.Shield" Size="Size.Small" />
                                    <span>Currency changes also update manual estimates and project budgets when saved.</span>
                                </div>
                            </div>
                        </section>
                    }
                    else if (_editorSection == ProjectEditorSection.Services)
                    {
                        <section class="fx-editor-section">
                            <div class="fx-editor-section-head">
                                <div>
                                    <span>Cost composition</span>
                                    <h3>Services in this project</h3>
                                    <p>Manual estimates remain editable. Cloud-synced resources stay locked to their source.</p>
                                </div>
                                <span class="fx-editor-step">@_editing.Services.Count total</span>
                            </div>

                            @if (_editing.Services.Count == 0)
                            {
                                <div class="fx-editor-empty">
                                    <MudIcon Icon="@Icons.Material.Filled.CloudQueue" />
                                    <strong>No services added yet</strong>
                                    <span>Add a manual estimate below, or discover resources from a connected account.</span>
                                </div>
                            }
                            else
                            {
                                <div class="fx-project-service-list">
                                    @foreach (var s in _editing.Services)
                                    {
                                        @if (s.Source == ServiceSource.Manual)
                                        {
                                            <article class="fx-project-service-card">
                                                <header>
                                                    <div class="fx-project-card-tags">
                                                        <span class="fx-chip @s.Provider.ToString().ToLower()">@ProviderLabel(s.Provider)</span>
                                                        <span class="fx-source-tag manual">Manual estimate</span>
                                                    </div>
                                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                                                   aria-label="Remove service" OnClick="@(() => RemoveService(s))" />
                                                </header>
                                                <div class="fx-project-service-fields">
                                                    <MudTextField @bind-Value="s.Name" Label="Service name" Variant="Variant.Outlined" />
                                                    <MudSelect T="CloudProvider" @bind-Value="s.Provider" Label="Provider" Variant="Variant.Outlined">
                                                        <MudSelectItem Value="CloudProvider.Aws">AWS</MudSelectItem>
                                                        <MudSelectItem Value="CloudProvider.Azure">Azure</MudSelectItem>
                                                        <MudSelectItem Value="CloudProvider.Gcp">GCP</MudSelectItem>
                                                    </MudSelect>
                                                    <MudNumericField @bind-Value="s.EstimatedCost"
                                                                     Label="@($"Monthly estimate ({_editing.Currency})")"
                                                                     Variant="Variant.Outlined" />
                                                </div>
                                            </article>
                                        }
                                        else
                                        {
                                            <article class="fx-project-service-card synced">
                                                <header>
                                                    <div class="fx-project-card-tags">
                                                        <span class="fx-chip @s.Provider.ToString().ToLower()">@ProviderLabel(s.Provider)</span>
                                                        <span class="fx-source-tag synced">Cloud synced</span>
                                                    </div>
                                                    <MudTooltip Text="@($"Synced from {AccountName(s.CloudAccountId)} — manage in Cloud Services")">
                                                        <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" />
                                                    </MudTooltip>
                                                </header>
                                                <div class="fx-project-synced-service">
                                                    <div><span>Resource</span><strong>@s.Name</strong></div>
                                                    <div><span>Type</span><strong>@(string.IsNullOrWhiteSpace(s.ServiceType) ? "Cloud resource" : s.ServiceType)</strong></div>
                                                    <div><span>Monthly cost</span><strong>@s.EstimatedCost.ToString("C0")</strong></div>
                                                </div>
                                            </article>
                                        }
                                    }
                                </div>
                            }

                            <div class="fx-editor-composer">
                                <div class="fx-editor-composer-head">
                                    <div>
                                        <span class="fx-chip @_newService.Provider.ToString().ToLower()">@ProviderLabel(_newService.Provider)</span>
                                        <strong>Add a custom service</strong>
                                    </div>
                                    <span>Use a simple monthly estimate; you can refine it later.</span>
                                </div>
                                <div class="fx-project-service-composer">
                                    <MudTextField @bind-Value="_newService.Name" Label="Service name" Variant="Variant.Outlined" />
                                    <MudSelect T="CloudProvider" @bind-Value="_newService.Provider" Label="Provider" Variant="Variant.Outlined">
                                        <MudSelectItem Value="CloudProvider.Aws">AWS</MudSelectItem>
                                        <MudSelectItem Value="CloudProvider.Azure">Azure</MudSelectItem>
                                        <MudSelectItem Value="CloudProvider.Gcp">GCP</MudSelectItem>
                                    </MudSelect>
                                    <MudNumericField @bind-Value="_newService.EstimatedCost"
                                                     Label="@($"Monthly estimate ({_editing.Currency})")"
                                                     Variant="Variant.Outlined" />
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                                               Disabled="@(string.IsNullOrWhiteSpace(_newService.Name))" OnClick="AddService">
                                        Add service
                                    </MudButton>
                                </div>
                            </div>
                        </section>
                    }
                    else if (_editorSection == ProjectEditorSection.Budgets)
                    {
                        <section class="fx-editor-section">
                            <div class="fx-editor-section-head">
                                <div>
                                    <span>Spend guardrails</span>
                                    <h3>Budgets and alerts</h3>
                                    <p>Set clear limits and choose when the project should start warning you.</p>
                                </div>
                                <span class="fx-editor-step">@_editing.Budgets.Count configured</span>
                            </div>

                            @if (_editing.Budgets.Count == 0)
                            {
                                <div class="fx-editor-empty compact">
                                    <MudIcon Icon="@Icons.Material.Filled.Shield" />
                                    <strong>No budget guardrail yet</strong>
                                    <span>Add one below to track spend against a cap.</span>
                                </div>
                            }
                            else
                            {
                                <div class="fx-project-budget-list">
                                    @foreach (var b in _editing.Budgets)
                                    {
                                        <article class="fx-project-budget-card">
                                            <header>
                                                <div>
                                                    <span>Budget guardrail</span>
                                                    <strong>@(string.IsNullOrWhiteSpace(b.Name) ? "Untitled budget" : b.Name)</strong>
                                                </div>
                                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                                               aria-label="Remove budget" OnClick="@(() => RemoveBudget(b))" />
                                            </header>
                                            <div class="fx-project-budget-fields">
                                                <MudTextField @bind-Value="b.Name" Label="Budget name" Variant="Variant.Outlined" />
                                                <MudNumericField @bind-Value="b.Amount" Label="@($"Amount ({_editing.Currency})")"
                                                                 Variant="Variant.Outlined" />
                                                <MudSelect T="BudgetPeriod" @bind-Value="b.Period" Label="Period" Variant="Variant.Outlined">
                                                    <MudSelectItem Value="BudgetPeriod.Monthly">Monthly</MudSelectItem>
                                                    <MudSelectItem Value="BudgetPeriod.Quarterly">Quarterly</MudSelectItem>
                                                    <MudSelectItem Value="BudgetPeriod.Annual">Annual</MudSelectItem>
                                                </MudSelect>
                                                <MudTextField @bind-Value="b.Thresholds" Label="Alert levels (%)"
                                                              HelperText="Comma separated, e.g. 50,80,100" Variant="Variant.Outlined" />
                                            </div>
                                        </article>
                                    }
                                </div>
                            }

                            <div class="fx-editor-composer">
                                <div class="fx-editor-composer-head">
                                    <div>
                                        <MudIcon Icon="@Icons.Material.Filled.Shield" Size="Size.Small" />
                                        <strong>Add a budget</strong>
                                    </div>
                                    <span>New budgets start enabled with 50%, 80% and 100% alerts.</span>
                                </div>
                                <div class="fx-project-budget-composer">
                                    <MudTextField @bind-Value="_newBudget.Name" Label="Budget name" Placeholder="e.g. Monthly cap"
                                                  Variant="Variant.Outlined" />
                                    <MudNumericField @bind-Value="_newBudget.Amount" Label="@($"Amount ({_editing.Currency})")"
                                                     Variant="Variant.Outlined" />
                                    <MudSelect T="BudgetPeriod" @bind-Value="_newBudget.Period" Label="Period" Variant="Variant.Outlined">
                                        <MudSelectItem Value="BudgetPeriod.Monthly">Monthly</MudSelectItem>
                                        <MudSelectItem Value="BudgetPeriod.Quarterly">Quarterly</MudSelectItem>
                                        <MudSelectItem Value="BudgetPeriod.Annual">Annual</MudSelectItem>
                                    </MudSelect>
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                                               OnClick="AddBudget">Add budget</MudButton>
                                </div>
                            </div>
                        </section>
                    }
                    else
                    {
                        <section class="fx-editor-section">
                            <div class="fx-editor-section-head">
                                <div>
                                    <span>Connected inventory</span>
                                    <h3>Bring in cloud resources</h3>
                                    <p>Discover existing resources and group them into this project without duplicating cloud data.</p>
                                </div>
                                <span class="fx-editor-step">@_accounts.Count accounts</span>
                            </div>

                            @if (_accounts.Count == 0)
                            {
                                <div class="fx-editor-empty">
                                    <MudIcon Icon="@Icons.Material.Filled.CloudQueue" />
                                    <strong>No cloud accounts connected</strong>
                                    <span>Connect an AWS, Azure or GCP account from Cloud Services before importing resources.</span>
                                </div>
                            }
                            else
                            {
                                <div class="fx-editor-surface">
                                    <div class="fx-project-discovery-controls">
                                        <MudSelect T="int?" @bind-Value="_discoverAccountId" Label="Connected account"
                                                   Variant="Variant.Outlined">
                                            @foreach (var a in _accounts)
                                            {
                                                <MudSelectItem T="int?" Value="@a.Id">@a.DisplayName (@ProviderLabel(a.Provider))</MudSelectItem>
                                            }
                                        </MudSelect>
                                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                                   StartIcon="@Icons.Material.Filled.Search" OnClick="DiscoverAsync"
                                                   Disabled="@(_discovering || _discoverAccountId is null)">
                                            @(_discovering ? "Discovering…" : "Discover resources")
                                        </MudButton>
                                    </div>
                                </div>
                            }

                            @if (_discovered is not null)
                            {
                                @if (_discovered.Count == 0)
                                {
                                    <div class="fx-editor-empty compact">
                                        <MudIcon Icon="@Icons.Material.Filled.Search" />
                                        <strong>No resources found</strong>
                                        <span>Try another connected account or sync the account again.</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="fx-project-resource-toolbar">
                                        <div>
                                            <strong>Discovered resources</strong>
                                            <span>Select the resources to include in this project.</span>
                                        </div>
                                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                                                   OnClick="AddSelectedResources" Disabled="@(_selected.Count == 0)">
                                            Add @_selected.Count selected
                                        </MudButton>
                                    </div>
                                    <div class="fx-project-resource-grid">
                                        @foreach (var r in _discovered)
                                        {
                                            <div class="fx-project-resource-card @(_selected.Contains(r.ExternalId) ? "selected" : "")">
                                                <MudCheckBox T="bool" Value="@_selected.Contains(r.ExternalId)"
                                                             ValueChanged="@(v => Toggle(r.ExternalId, v))" />
                                                <div>
                                                    <span class="fx-chip @r.Provider.ToString().ToLower()">@ProviderLabel(r.Provider)</span>
                                                    <strong>@r.Name</strong>
                                                    <span>@r.ResourceType</span>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        </section>
                    }
                </main>
            </div>
        </ChildContent>
        <FooterContent>
            <MudButton OnClick="CloseEditor">Cancel</MudButton>
            @if (_editorSection != ProjectEditorSection.Basics)
            {
                <MudButton StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="PreviousSection">Back</MudButton>
            }
            @if (_editorSection != ProjectEditorSection.CloudResources)
            {
                <MudButton Variant="Variant.Outlined" EndIcon="@Icons.Material.Filled.ArrowForward"
                           OnClick="NextSection">Next</MudButton>
            }
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                       Disabled="@(string.IsNullOrWhiteSpace(_editing.Name))" OnClick="SaveAsync">
                Save project
            </MudButton>
        </FooterContent>
    </AppModal>
}

@code {
    private static readonly string[] Currencies = { "USD", "EUR", "GBP", "BGN", "CAD", "AUD" };

    private List<Project> _projects = new();
    private List<Client> _clients = new();
    private List<CloudAccount> _accounts = new();
    private Project? _editing;
    private Service _newService = new();
    private Budget _newBudget = new() { Thresholds = "50,80,100" };
    private ProjectEditorSection _editorSection = ProjectEditorSection.Basics;

    // "Choose existing resources" state
    private int? _discoverAccountId;
    private bool _discovering;
    private IReadOnlyList<DiscoveredResource>? _discovered;
    private readonly HashSet<string> _selected = new();

    private enum ProjectEditorSection
    {
        Basics,
        Services,
        Budgets,
        CloudResources
    }

    private int ManualServiceCount
        => _editing?.Services.Count(s => s.Source == ServiceSource.Manual) ?? 0;

    private int ConnectedServiceCount
        => _editing?.Services.Count(s => s.Source == ServiceSource.Connected) ?? 0;

    private string ProjectDisplayName
        => string.IsNullOrWhiteSpace(_editing?.Name) ? "Untitled project" : _editing!.Name;

    private string ProjectSummary
    {
        get
        {
            if (_editing is null) return "";
            var client = _clients.FirstOrDefault(c => c.Id == _editing.ClientId)?.Name ?? "No client assigned";
            return $"{client} · {_editing.Currency} reporting";
        }
    }

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _projects = await db.Projects
            .Include(p => p.Client)
            .Include(p => p.Services)
            .Include(p => p.Budgets)
            .OrderBy(p => p.Name)
            .ToListAsync();
        _clients = await db.Clients.OrderBy(c => c.Name).ToListAsync();
        _accounts = await db.CloudAccounts.OrderBy(a => a.DisplayName).ToListAsync();
    }

    private string AccountName(int? accountId)
        => _accounts.FirstOrDefault(a => a.Id == accountId)?.DisplayName ?? "cloud account";

    private static string ProviderLabel(CloudProvider provider) => provider switch
    {
        CloudProvider.Aws => "AWS",
        CloudProvider.Azure => "Azure",
        CloudProvider.Gcp => "GCP",
        _ => provider.ToString()
    };

    private static string StatusClass(ProjectStatus status)
        => status.ToString().ToLowerInvariant();

    private string SectionClass(ProjectEditorSection section)
        => $"fx-project-editor-nav-item {(_editorSection == section ? "active" : "")}";

    private void OpenSection(ProjectEditorSection section) => _editorSection = section;

    private void PreviousSection()
    {
        if (_editorSection > ProjectEditorSection.Basics)
            _editorSection = (ProjectEditorSection)((int)_editorSection - 1);
    }

    private void NextSection()
    {
        if (_editorSection < ProjectEditorSection.CloudResources)
            _editorSection = (ProjectEditorSection)((int)_editorSection + 1);
    }

    private void Edit(Project p)
    {
        _editing = p;
        _editorSection = ProjectEditorSection.Basics;
        _newService = new Service();
        _newBudget = new Budget { Thresholds = "50,80,100", Period = BudgetPeriod.Monthly };
        _discovered = null;
        _selected.Clear();
        _discoverAccountId = _accounts.FirstOrDefault()?.Id;
    }

    private void CloseEditor() => _editing = null;

    private void Toggle(string id, bool on)
    {
        if (on) _selected.Add(id); else _selected.Remove(id);
    }

    private async Task DiscoverAsync()
    {
        if (_discoverAccountId is null) return;
        _discovering = true;
        _selected.Clear();
        try
        {
            _discovered = await Connections.DiscoverAsync(_discoverAccountId.Value);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Discovery failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _discovering = false;
        }
    }

    private void AddSelectedResources()
    {
        if (_editing is null || _discovered is null) return;
        foreach (var r in _discovered.Where(r => _selected.Contains(r.ExternalId)))
        {
            _editing.Services.Add(new Service
            {
                Name = r.Name,
                Provider = r.Provider,
                ServiceType = r.ResourceType,
                Source = ServiceSource.Connected,
                ExternalResourceId = r.ExternalId,
                CloudAccountId = _discoverAccountId,
                Currency = _editing.Currency
            });
        }
        Snackbar.Add($"Added {_selected.Count} resource(s)", Severity.Success);
        _selected.Clear();
        _discovered = null;
        _editorSection = ProjectEditorSection.Services;
    }

    private void AddService()
    {
        if (_editing is null || string.IsNullOrWhiteSpace(_newService.Name)) return;
        _newService.Currency = _editing.Currency;
        _newService.Source = ServiceSource.Manual;
        _editing.Services.Add(_newService);
        _newService = new Service();
    }

    // Only manual services reach this (connected ones don't render a remove button).
    private void RemoveService(Service s)
    {
        if (s.Source != ServiceSource.Manual) return;
        _editing?.Services.Remove(s);
    }

    private void AddBudget()
    {
        if (_editing is null) return;
        _newBudget.Currency = _editing.Currency;
        _newBudget.IsEnabled = true;
        if (string.IsNullOrWhiteSpace(_newBudget.Name)) _newBudget.Name = "Budget";
        if (string.IsNullOrWhiteSpace(_newBudget.Thresholds)) _newBudget.Thresholds = "50,80,100";
        _editing.Budgets.Add(_newBudget);
        _newBudget = new Budget { Thresholds = "50,80,100", Period = BudgetPeriod.Monthly };
    }

    private void RemoveBudget(Budget b) => _editing?.Budgets.Remove(b);

    private async Task SaveAsync()
    {
        if (_editing is null || string.IsNullOrWhiteSpace(_editing.Name)) return;
        var project = _editing;
        await using var db = await DbFactory.CreateDbContextAsync();

        if (project.Id == 0)
        {
            // New project: the whole graph (services + budgets) is inserted together.
            foreach (var s in project.Services) s.Currency = project.Currency;
            foreach (var b in project.Budgets) b.Currency = project.Currency;
            db.Projects.Add(project);
            await db.SaveChangesAsync();
        }
        else
        {
            // Existing project: reconcile against the tracked entity so removed children are deleted
            // (EF's detached Update does not delete orphaned collection items).
            var existing = await db.Projects
                .Include(p => p.Services)
                .Include(p => p.Budgets)
                .FirstAsync(p => p.Id == project.Id);

            existing.Name = project.Name;
            existing.Description = project.Description;
            existing.ClientId = project.ClientId;
            existing.Currency = project.Currency;
            existing.Status = project.Status;

            // ---- Services ----
            var keepServiceIds = project.Services.Where(s => s.Id > 0).Select(s => s.Id).ToHashSet();
            foreach (var es in existing.Services.ToList())
            {
                // Remove only manual services the user deleted; connected services stay (managed elsewhere).
                if (es.Source == ServiceSource.Manual && !keepServiceIds.Contains(es.Id))
                    db.Services.Remove(es);
            }
            foreach (var s in project.Services)
            {
                if (s.Id == 0)
                {
                    existing.Services.Add(new Service
                    {
                        Name = s.Name,
                        Provider = s.Provider,
                        ServiceType = s.ServiceType,
                        Tier = s.Tier,
                        Source = s.Source,
                        ExternalResourceId = s.ExternalResourceId,
                        CloudAccountId = s.CloudAccountId,
                        EstimatedCost = s.EstimatedCost,
                        EstimatePeriod = s.EstimatePeriod,
                        Currency = project.Currency
                    });
                }
                else
                {
                    var match = existing.Services.FirstOrDefault(x => x.Id == s.Id);
                    if (match is { Source: ServiceSource.Manual })
                    {
                        match.Name = s.Name;
                        match.Provider = s.Provider;
                        match.EstimatedCost = s.EstimatedCost;
                        match.Currency = project.Currency;
                    }
                }
            }

            // ---- Budgets ----
            var keepBudgetIds = project.Budgets.Where(b => b.Id > 0).Select(b => b.Id).ToHashSet();
            foreach (var eb in existing.Budgets.ToList())
                if (!keepBudgetIds.Contains(eb.Id))
                    db.Budgets.Remove(eb);

            foreach (var b in project.Budgets)
            {
                if (b.Id == 0)
                {
                    existing.Budgets.Add(new Budget
                    {
                        Name = string.IsNullOrWhiteSpace(b.Name) ? "Budget" : b.Name,
                        Period = b.Period,
                        Amount = b.Amount,
                        Currency = project.Currency,
                        Thresholds = string.IsNullOrWhiteSpace(b.Thresholds) ? "50,80,100" : b.Thresholds,
                        IsEnabled = true
                    });
                }
                else
                {
                    var match = existing.Budgets.FirstOrDefault(x => x.Id == b.Id);
                    if (match is not null)
                    {
                        match.Name = b.Name;
                        match.Period = b.Period;
                        match.Amount = b.Amount;
                        match.Currency = project.Currency;
                        match.Thresholds = b.Thresholds;
                        match.IsEnabled = b.IsEnabled;
                    }
                }
            }

            await db.SaveChangesAsync();
        }

        _editing = null;
        await InvokeAsync(StateHasChanged);
        Snackbar.Add("Project saved", Severity.Success);
        await LoadAsync();
    }
}
