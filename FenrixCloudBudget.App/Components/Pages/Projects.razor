@page "/projects"
@inject IDbContextFactory<AppDbContext> DbFactory
@inject CloudConnectionService Connections
@inject ISnackbar Snackbar

<section class="fx-page-header">
    <div class="fx-page-heading">
        <div class="fx-eyebrow">Cross-cloud workspaces</div>
        <h1 class="fx-page-title">Projects</h1>
        <p class="fx-page-sub">Group cloud services across providers into client/project buckets.</p>
    </div>
    <MudButton Class="fx-page-action" Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => Edit(new Project()))">
        New project
    </MudButton>
</section>

<div class="fx-tiles">
    @foreach (var p in _projects)
    {
        <button type="button" class="fx-tile fx-project-tile" @onclick="@(() => Edit(p))">
            <div class="fx-tile-title">@p.Name</div>
            <div class="fx-project-client">@(p.Client?.Name ?? "No client")</div>
            <div class="fx-chip-row">
                @foreach (var prov in p.Services.Select(s => s.Provider).Distinct())
                {
                    <span class="fx-chip @prov.ToString().ToLower()">@prov</span>
                }
            </div>
            <div class="fx-tile-stat fx-project-spend">
                @p.Services.Sum(s => s.EstimatedCost).ToString("C0") <small>/mo est. (@p.Currency)</small>
            </div>
        </button>
    }
    @if (_projects.Count == 0) { <Empty Text="No projects yet." /> }
</div>

@if (_editing is not null)
{
    <AppModal Title="@(_editing.Id == 0 ? "New project" : _editing.Name)"
              Width="large"
              OnCancel="CloseEditor">
        <ChildContent>
            <MudTextField @bind-Value="_editing.Name" Label="Name *" Required="true" />
            <MudTextField @bind-Value="_editing.Description" Label="Description" Lines="2" />
            <div class="fx-form-row">
                <MudSelect T="int?" @bind-Value="_editing.ClientId" Label="Client" Clearable="true" Class="fx-form-grow">
                    @foreach (var c in _clients)
                    {
                        <MudSelectItem T="int?" Value="@c.Id">@c.Name</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="string" @bind-Value="_editing.Currency" Label="Currency" Class="fx-form-compact">
                    @foreach (var cur in Currencies)
                    {
                        <MudSelectItem Value="@cur">@cur</MudSelectItem>
                    }
                </MudSelect>
            </div>

            <MudText Typo="Typo.subtitle2" Class="mt-4">Services</MudText>
            <MudText Typo="Typo.caption" Class="mb-2">
                Add services manually, or use "Choose existing resources" (Phase 3) to import from a connected account.
            </MudText>
            @foreach (var s in _editing.Services)
            {
                <div class="fx-service-row">
                    <span class="fx-chip @s.Provider.ToString().ToLower()">@s.Provider</span>
                    <span class="fx-service-name">@s.Name</span>
                    <strong>@s.EstimatedCost.ToString("C0")</strong>
                </div>
            }
            <div class="fx-service-entry">
                <MudTextField @bind-Value="_newService.Name" Label="Service name" Class="fx-form-grow" />
                <MudSelect T="CloudProvider" @bind-Value="_newService.Provider" Label="Provider" Class="fx-form-compact">
                    <MudSelectItem Value="CloudProvider.Aws">AWS</MudSelectItem>
                    <MudSelectItem Value="CloudProvider.Azure">Azure</MudSelectItem>
                    <MudSelectItem Value="CloudProvider.Gcp">GCP</MudSelectItem>
                </MudSelect>
                <MudNumericField @bind-Value="_newService.EstimatedCost" Label="Est./mo" Class="fx-form-compact" />
                <MudButton Class="fx-inline-action" OnClick="AddService">Add</MudButton>
            </div>

            <MudDivider Class="my-3" />
            <MudText Typo="Typo.subtitle2">Choose existing resources</MudText>
            <MudText Typo="Typo.caption" Class="mb-2">Import resources from a connected cloud account (cross-account grouping).</MudText>
            <div class="fx-discovery-controls">
                <MudSelect T="int?" @bind-Value="_discoverAccountId" Label="Connected account" Class="fx-form-grow">
                    @foreach (var a in _accounts)
                    {
                        <MudSelectItem T="int?" Value="@a.Id">@a.DisplayName (@a.Provider)</MudSelectItem>
                    }
                </MudSelect>
                <MudButton Class="fx-inline-action" StartIcon="@Icons.Material.Filled.Search" OnClick="DiscoverAsync" Disabled="_discovering">
                    @(_discovering ? "…" : "Discover")
                </MudButton>
            </div>

            @if (_discovered is not null)
            {
                <div class="fx-discovery-list">
                    @foreach (var r in _discovered)
                    {
                        <div class="fx-discovery-item">
                            <MudCheckBox T="bool" Value="@_selected.Contains(r.ExternalId)"
                                         ValueChanged="@(v => Toggle(r.ExternalId, v))" Dense="true" />
                            <span class="fx-chip @r.Provider.ToString().ToLower()">@r.Provider</span>
                            <span class="fx-discovery-name">@r.Name</span>
                            <span class="fx-discovery-type">@r.ResourceType</span>
                        </div>
                    }
                </div>
                <MudButton Variant="Variant.Outlined" Class="mt-2" OnClick="AddSelectedResources"
                           Disabled="_selected.Count == 0">Add @_selected.Count selected</MudButton>
            }
        </ChildContent>
        <FooterContent>
            <MudButton OnClick="CloseEditor">Cancel</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">Save</MudButton>
        </FooterContent>
    </AppModal>
}

@code {
    private static readonly string[] Currencies = { "USD", "EUR", "GBP", "BGN", "CAD", "AUD" };

    private List<Project> _projects = new();
    private List<Client> _clients = new();
    private List<CloudAccount> _accounts = new();
    private Project? _editing;
    private Service _newService = new();

    // "Choose existing resources" state
    private int? _discoverAccountId;
    private bool _discovering;
    private IReadOnlyList<DiscoveredResource>? _discovered;
    private readonly HashSet<string> _selected = new();

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _projects = await db.Projects.Include(p => p.Client).Include(p => p.Services).OrderBy(p => p.Name).ToListAsync();
        _clients = await db.Clients.OrderBy(c => c.Name).ToListAsync();
        _accounts = await db.CloudAccounts.OrderBy(a => a.DisplayName).ToListAsync();
    }

    private void Edit(Project p)
    {
        _editing = p;
        _newService = new Service();
        _discovered = null;
        _selected.Clear();
        _discoverAccountId = _accounts.FirstOrDefault()?.Id;
    }

    private void CloseEditor() => _editing = null;

    private void Toggle(string id, bool on)
    {
        if (on) _selected.Add(id); else _selected.Remove(id);
    }

    private async Task DiscoverAsync()
    {
        if (_discoverAccountId is null) return;
        _discovering = true;
        _selected.Clear();
        try
        {
            _discovered = await Connections.DiscoverAsync(_discoverAccountId.Value);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Discovery failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _discovering = false;
        }
    }

    private void AddSelectedResources()
    {
        if (_editing is null || _discovered is null) return;
        foreach (var r in _discovered.Where(r => _selected.Contains(r.ExternalId)))
        {
            _editing.Services.Add(new Service
            {
                Name = r.Name,
                Provider = r.Provider,
                ServiceType = r.ResourceType,
                Source = ServiceSource.Connected,
                ExternalResourceId = r.ExternalId,
                CloudAccountId = _discoverAccountId,
                Currency = _editing.Currency
            });
        }
        Snackbar.Add($"Added {_selected.Count} resource(s)", Severity.Success);
        _selected.Clear();
        _discovered = null;
    }

    private void AddService()
    {
        if (_editing is null || string.IsNullOrWhiteSpace(_newService.Name)) return;
        _newService.Currency = _editing.Currency;
        _editing.Services.Add(_newService);
        _newService = new Service();
    }

    private async Task SaveAsync()
    {
        if (_editing is null || string.IsNullOrWhiteSpace(_editing.Name)) return;
        var project = _editing;
        await using var db = await DbFactory.CreateDbContextAsync();
        if (project.Id == 0) db.Projects.Add(project);
        else db.Projects.Update(project);
        await db.SaveChangesAsync();
        _editing = null;
        await InvokeAsync(StateHasChanged);
        Snackbar.Add("Project saved", Severity.Success);
        await LoadAsync();
    }
}
