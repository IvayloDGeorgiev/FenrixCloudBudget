@page "/clients"
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ISnackbar Snackbar

<section class="fx-page-header">
    <div class="fx-page-heading">
        <div class="fx-eyebrow">Portfolio relationships</div>
        <h1 class="fx-page-title">Clients</h1>
        <p class="fx-page-sub">Companies you bill. Projects roll up to a client.</p>
    </div>
    <MudButton Class="fx-page-action" Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => Edit(new Client()))">
        New client
    </MudButton>
</section>

@if (_clients.Count == 0)
{
    <div class="fx-card">
        <Empty Text="No clients yet. Create your first one." />
    </div>
}
else
{
    <div class="fx-client-grid">
        @foreach (var c in _clients)
        {
            <article class="fx-client-card">
                <div class="fx-client-card-head">
                    <div class="fx-client-avatar">@ClientInitials(c)</div>
                    <div>
                        <h2>@c.Name</h2>
                        <span>@(string.IsNullOrWhiteSpace(c.CompanyName) ? "Independent client" : c.CompanyName)</span>
                    </div>
                    <div class="fx-client-card-actions">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Size="Size.Small"
                                       title="Edit client"
                                       aria-label="Edit client"
                                       OnClick="@(() => Edit(c))" />
                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                       Size="Size.Small"
                                       Color="Color.Error"
                                       title="Delete client"
                                       aria-label="Delete client"
                                       OnClick="@(() => RequestDelete(c, false))" />
                    </div>
                </div>
                <div class="fx-client-meta">
                    <div>
                        <MudIcon Icon="@Icons.Material.Filled.Email" Size="Size.Small" />
                        <span>@(string.IsNullOrWhiteSpace(c.ContactEmail) ? "No email added" : c.ContactEmail)</span>
                    </div>
                    <div>
                        <MudIcon Icon="@Icons.Material.Filled.FolderOpen" Size="Size.Small" />
                        <span>@c.Projects.Count project@(c.Projects.Count == 1 ? "" : "s")</span>
                    </div>
                </div>
            </article>
        }
    </div>
}

@if (_editing is not null)
{
    <AppModal Title="@(_editing.Id == 0 ? "New client" : "Edit client")"
              Width="small"
              OnCancel="CloseEditor">
        <ChildContent>
            <MudTextField @bind-Value="_editing.Name" Label="Name *" Required="true" />
            <MudTextField @bind-Value="_editing.CompanyName" Label="Company" />
            <MudTextField @bind-Value="_editing.ContactName" Label="Contact name" />
            <MudTextField @bind-Value="_editing.ContactEmail" Label="Contact email" />
            <MudTextField @bind-Value="_editing.ContactPhone" Label="Phone" />
            <MudTextField @bind-Value="_editing.BillingAddress" Label="Billing address" Lines="2" />
            <MudTextField @bind-Value="_editing.Notes" Label="Notes" Lines="2" />
        </ChildContent>
        <FooterContent>
            @if (_editing.Id > 0)
            {
                <MudButton Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.Delete"
                           OnClick="@(() => RequestDelete(_editing!, true))">
                    Delete client
                </MudButton>
                <span class="fx-action-spacer"></span>
            }
            <MudButton OnClick="CloseEditor">Cancel</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">Save</MudButton>
        </FooterContent>
    </AppModal>
}

@if (_deleting is not null)
{
    <ConfirmDeleteModal Title="Delete client?"
                        ItemName="@_deleting.Name"
                        Message="@DeleteMessage"
                        ConfirmText="Delete client"
                        CancelText="Keep client"
                        Icon="@Icons.Material.Filled.DeleteForever"
                        OnCancel="CancelDelete"
                        OnConfirm="ConfirmDeleteAsync" />
}

@code {
    private List<Client> _clients = new();
    private Client? _editing;
    private Client? _deleting;
    private bool _returnToEditorAfterDelete;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _clients = await db.Clients.Include(c => c.Projects).OrderBy(c => c.Name).ToListAsync();
    }

    private void Edit(Client c)
    {
        _editing = c;
    }

    private void CloseEditor() => _editing = null;

    private string DeleteMessage
    {
        get
        {
            var projectCount = _deleting?.Projects.Count ?? 0;
            var projectImpact = projectCount switch
            {
                0 => "It has no linked projects.",
                1 => "Its linked project will remain and become unassigned.",
                _ => $"Its {projectCount} linked projects will remain and become unassigned."
            };
            return $"This permanently removes the client. {projectImpact} This action cannot be undone.";
        }
    }

    private void RequestDelete(Client client, bool returnToEditor)
    {
        if (client.Id == 0) return;
        _deleting = client;
        _returnToEditorAfterDelete = returnToEditor;
        if (returnToEditor)
            _editing = null;
    }

    private void CancelDelete()
    {
        if (_returnToEditorAfterDelete)
            _editing = _deleting;

        _deleting = null;
        _returnToEditorAfterDelete = false;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_deleting is null) return;

        var clientId = _deleting.Id;
        _deleting = null;
        _editing = null;
        _returnToEditorAfterDelete = false;
        await InvokeAsync(StateHasChanged);

        await using var db = await DbFactory.CreateDbContextAsync();
        var client = await db.Clients.FirstOrDefaultAsync(item => item.Id == clientId);
        if (client is not null)
        {
            db.Clients.Remove(client);
            await db.SaveChangesAsync();
        }

        Snackbar.Add("Client deleted. Existing projects are now unassigned.", Severity.Success);
        await LoadAsync();
    }

    private static string ClientInitials(Client client)
    {
        var source = string.IsNullOrWhiteSpace(client.Name) ? "Client" : client.Name;
        var words = source.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return words.Length > 1
            ? string.Concat(words.Take(2).Select(word => char.ToUpperInvariant(word[0])))
            : source[..Math.Min(2, source.Length)].ToUpperInvariant();
    }

    private async Task SaveAsync()
    {
        if (_editing is null || string.IsNullOrWhiteSpace(_editing.Name)) return;
        var client = _editing;
        await using var db = await DbFactory.CreateDbContextAsync();
        if (client.Id == 0) db.Clients.Add(client);
        else db.Clients.Update(client);
        await db.SaveChangesAsync();
        _editing = null;
        await InvokeAsync(StateHasChanged);
        Snackbar.Add("Client saved", Severity.Success);
        await LoadAsync();
    }
}
