@page "/clients"
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ISnackbar Snackbar

<div style="display:flex;align-items:center;gap:12px">
    <div>
        <h1 class="fx-page-title">Clients</h1>
        <p class="fx-page-sub">Companies you bill. Projects roll up to a client.</p>
    </div>
    <MudSpacer />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => Edit(new Client()))">
        New client
    </MudButton>
</div>

<div class="fx-card">
    @if (_clients.Count == 0)
    {
        <Empty Text="No clients yet. Create your first one." />
    }
    else
    {
        <MudSimpleTable Hover="true" Dense="true">
            <thead><tr><th>Name</th><th>Company</th><th>Contact</th><th>Projects</th><th></th></tr></thead>
            <tbody>
                @foreach (var c in _clients)
                {
                    <tr>
                        <td>@c.Name</td>
                        <td>@c.CompanyName</td>
                        <td>@c.ContactEmail</td>
                        <td>@c.Projects.Count</td>
                        <td style="text-align:right">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => Edit(c))" />
                        </td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    }
</div>

@if (_editing is not null)
{
    <MudDialog @bind-Visible="_dialogOpen" Options="new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true }">
        <TitleContent>@(_editing.Id == 0 ? "New client" : "Edit client")</TitleContent>
        <DialogContent>
            <MudTextField @bind-Value="_editing.Name" Label="Name *" Required="true" />
            <MudTextField @bind-Value="_editing.CompanyName" Label="Company" />
            <MudTextField @bind-Value="_editing.ContactName" Label="Contact name" />
            <MudTextField @bind-Value="_editing.ContactEmail" Label="Contact email" />
            <MudTextField @bind-Value="_editing.ContactPhone" Label="Phone" />
            <MudTextField @bind-Value="_editing.BillingAddress" Label="Billing address" Lines="2" />
            <MudTextField @bind-Value="_editing.Notes" Label="Notes" Lines="2" />
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="@(() => _dialogOpen = false)">Cancel</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">Save</MudButton>
        </DialogActions>
    </MudDialog>
}

@code {
    private List<Client> _clients = new();
    private Client? _editing;
    private bool _dialogOpen;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _clients = await db.Clients.Include(c => c.Projects).OrderBy(c => c.Name).ToListAsync();
    }

    private void Edit(Client c)
    {
        _editing = c;
        _dialogOpen = true;
    }

    private async Task SaveAsync()
    {
        if (_editing is null || string.IsNullOrWhiteSpace(_editing.Name)) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        if (_editing.Id == 0) db.Clients.Add(_editing);
        else db.Clients.Update(_editing);
        await db.SaveChangesAsync();
        _dialogOpen = false;
        Snackbar.Add("Client saved", Severity.Success);
        await LoadAsync();
    }
}
