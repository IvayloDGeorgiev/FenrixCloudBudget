@page "/reminders"
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ISnackbar Snackbar

<div class="fx-reminder-header">
    <div>
        <div class="fx-eyebrow">Attention queue</div>
        <h1 class="fx-page-title">Reminders</h1>
        <p class="fx-page-sub">Client secret & certificate expiries, plus custom reminders — never miss a rotation.</p>
    </div>
    <MudSpacer />
    <MudButton Class="fx-no-wrap" Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="@(() => Edit(new Reminder { DueDate = DateTimeOffset.Now.AddDays(30) }))">
        New reminder
    </MudButton>
</div>

<div class="fx-card">
    @if (_reminders.Count == 0)
    {
        <Empty Text="No reminders yet." />
    }
    else
    {
        <MudSimpleTable Hover="true" Dense="true">
            <thead><tr><th>Title</th><th>Type</th><th>Due</th><th>In</th><th>Status</th><th></th></tr></thead>
            <tbody>
                @foreach (var r in _reminders.OrderBy(r => r.DueDate))
                {
                    var days = (DateOnly.FromDateTime(r.DueDate.UtcDateTime).DayNumber - DateOnly.FromDateTime(DateTime.UtcNow).DayNumber);
                    <tr>
                        <td>@r.Title</td>
                        <td>@Pretty(r.Type)</td>
                        <td>@r.DueDate.LocalDateTime.ToString("yyyy-MM-dd")</td>
                        <td>
                            <MudChip T="string" Size="Size.Small"
                                     Color="@(days < 0 ? Color.Error : days <= 7 ? Color.Warning : Color.Default)">
                                @(days < 0 ? $"{-days}d overdue" : $"{days}d")
                            </MudChip>
                        </td>
                        <td>
                            <MudChip T="string" Size="Size.Small" Color="@StatusColor(r.Status)">
                                @StatusLabel(r.Status)
                            </MudChip>
                        </td>
                        <td>
                            <div class="fx-reminder-actions">
                                @if (r.Status == ReminderStatus.Active)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Snooze"
                                                   Size="Size.Small"
                                                   aria-label="Snooze for 7 days"
                                                   title="Snooze for 7 days"
                                                   OnClick="@(() => Snooze(r))" />
                                    <MudIconButton Icon="@Icons.Material.Filled.TaskAlt"
                                                   Size="Size.Small"
                                                   Color="Color.Success"
                                                   aria-label="Mark as complete"
                                                   title="Mark as complete"
                                                   OnClick="@(() => MarkDone(r))" />
                                }
                                else
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.PlayCircle"
                                                   Size="Size.Small"
                                                   Color="Color.Primary"
                                                   aria-label="Restore to active"
                                                   title="Restore to active"
                                                   OnClick="@(() => RestoreActive(r))" />
                                }
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Size="Size.Small"
                                               aria-label="Edit reminder"
                                               title="Edit reminder"
                                               OnClick="@(() => Edit(r))" />
                                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                               Size="Size.Small"
                                               Color="Color.Error"
                                               aria-label="Delete reminder"
                                               title="Delete reminder"
                                               OnClick="@(() => RequestDelete(r))" />
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    }
</div>

@if (_editing is not null)
{
    <MudDialog @bind-Visible="_dialogOpen" Options="new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true }">
        <TitleContent>@(_editing.Id == 0 ? "New reminder" : "Edit reminder")</TitleContent>
        <DialogContent>
            <MudTextField @bind-Value="_editing.Title" Label="Title *" Required="true" />
            <MudSelect T="ReminderType" @bind-Value="_editing.Type" Label="Type">
                <MudSelectItem Value="ReminderType.ClientSecret">Client secret</MudSelectItem>
                <MudSelectItem Value="ReminderType.Certificate">Certificate</MudSelectItem>
                <MudSelectItem Value="ReminderType.Custom">Custom</MudSelectItem>
            </MudSelect>

            @if (_editing.Type != ReminderType.Custom)
            {
                <MudSelect T="int?" @bind-Value="_editing.CloudAccountId" Label="Linked cloud account" Clearable="true">
                    @foreach (var a in _accounts)
                    {
                        <MudSelectItem T="int?" Value="@a.Id">@a.DisplayName (@a.Provider)</MudSelectItem>
                    }
                </MudSelect>
                <MudText Typo="Typo.caption">Link a connected account so the expiry can be auto-detected (auto-fill arrives with cost sync).</MudText>
            }
            <MudDatePicker Label="Due date" Date="_editing.DueDate.LocalDateTime" DateChanged="d => _editing.DueDate = d ?? DateTime.Now" />
            <MudTextField @bind-Value="_editing.LeadTimesDays" Label="Lead times (days, comma-separated)" />
            <MudTextField @bind-Value="_editing.Notes" Label="Notes" Lines="2" />
            <MudNumericField @bind-Value="_editing.RecurrenceDays" Label="Repeat every N days (0 = one-off)" />
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="@(() => _dialogOpen = false)">Cancel</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">Save</MudButton>
        </DialogActions>
    </MudDialog>
}

@if (_deleting is not null)
{
    <MudDialog @bind-Visible="_deleteDialogOpen"
               Options="new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true }">
        <TitleContent>Delete reminder?</TitleContent>
        <DialogContent>
            <div class="fx-delete-confirm">
                <div class="fx-delete-confirm-icon">
                    <MudIcon Icon="@Icons.Material.Filled.DeleteForever" />
                </div>
                <div>
                    <strong>@_deleting.Title</strong>
                    <p>This permanently removes the reminder. This action cannot be undone.</p>
                </div>
            </div>
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="CancelDelete">Keep reminder</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.Delete"
                       OnClick="ConfirmDeleteAsync">
                Delete
            </MudButton>
        </DialogActions>
    </MudDialog>
}

@code {
    private List<Reminder> _reminders = new();
    private List<CloudAccount> _accounts = new();
    private Reminder? _editing;
    private Reminder? _deleting;
    private bool _dialogOpen;
    private bool _deleteDialogOpen;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _reminders = await db.Reminders.ToListAsync();
        _accounts = await db.CloudAccounts.OrderBy(a => a.DisplayName).ToListAsync();
    }

    private static string Pretty(ReminderType t) => t switch
    {
        ReminderType.ClientSecret => "Client secret",
        ReminderType.Certificate => "Certificate",
        _ => "Custom"
    };

    private static string StatusLabel(ReminderStatus status) => status switch
    {
        ReminderStatus.Active => "Active",
        ReminderStatus.Snoozed => "Snoozed",
        ReminderStatus.Done => "Completed",
        ReminderStatus.Dismissed => "Dismissed",
        _ => status.ToString()
    };

    private static Color StatusColor(ReminderStatus status) => status switch
    {
        ReminderStatus.Active => Color.Success,
        ReminderStatus.Snoozed => Color.Warning,
        ReminderStatus.Done => Color.Default,
        ReminderStatus.Dismissed => Color.Default,
        _ => Color.Default
    };

    private void Edit(Reminder r) { _editing = r; _dialogOpen = true; }

    private async Task SaveAsync()
    {
        if (_editing is null || string.IsNullOrWhiteSpace(_editing.Title)) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        if (_editing.Id == 0) db.Reminders.Add(_editing);
        else db.Reminders.Update(_editing);
        await db.SaveChangesAsync();
        _dialogOpen = false;
        Snackbar.Add("Reminder saved", Severity.Success);
        await LoadAsync();
    }

    private async Task Snooze(Reminder r)
    {
        r.SnoozedUntilUtc = DateTimeOffset.UtcNow.AddDays(7);
        r.Status = ReminderStatus.Snoozed;
        await Persist(r, "Snoozed 7 days");
    }

    private async Task MarkDone(Reminder r)
    {
        r.Status = ReminderStatus.Done;
        r.SnoozedUntilUtc = null;
        await Persist(r, "Reminder completed");
    }

    private async Task RestoreActive(Reminder r)
    {
        r.Status = ReminderStatus.Active;
        r.SnoozedUntilUtc = null;
        r.LastFiredUtc = null;
        await Persist(r, "Reminder restored to active");
    }

    private void RequestDelete(Reminder reminder)
    {
        _deleting = reminder;
        _deleteDialogOpen = true;
    }

    private void CancelDelete()
    {
        _deleteDialogOpen = false;
        _deleting = null;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_deleting is null)
            return;

        var reminderId = _deleting.Id;

        // Remove the inline dialog from the render tree before doing any database work.
        // Waiting until the end lets MudDialog's visibility callback retain the open state.
        _deleteDialogOpen = false;
        _deleting = null;
        await InvokeAsync(StateHasChanged);
        await Task.Yield();

        await using var db = await DbFactory.CreateDbContextAsync();
        var reminder = await db.Reminders.FirstOrDefaultAsync(item => item.Id == reminderId);
        if (reminder is not null)
        {
            db.Reminders.Remove(reminder);
            await db.SaveChangesAsync();
        }

        await LoadAsync();
        Snackbar.Add("Reminder deleted", Severity.Success);
    }

    private async Task Persist(Reminder r, string msg)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        db.Reminders.Update(r);
        await db.SaveChangesAsync();
        Snackbar.Add(msg, Severity.Success);
        await LoadAsync();
    }
}
