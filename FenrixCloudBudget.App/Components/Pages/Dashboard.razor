@page "/dashboard"
@inject IDbContextFactory<AppDbContext> DbFactory
@inject DashboardAnalytics Analytics
@inject CostSyncService CostSync
@inject ISnackbar Snackbar

<section class="fx-page-header">
    <div class="fx-page-heading">
        <div class="fx-eyebrow">Cost intelligence</div>
        <h1 class="fx-page-title">Cloud command center</h1>
        <p class="fx-page-sub">@(_d?.LastSyncedLabel ?? "Loading…")</p>
    </div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="fx-page-action"
               StartIcon="@Icons.Material.Filled.Sync" Disabled="_syncing" OnClick="RefreshAsync">
        @(_syncing ? "Syncing costs…" : "Sync cloud costs")
    </MudButton>
</section>

@if (_d is not null)
{
    <div class="fx-dashboard-stack">
    <!-- KPI row -->
    <section class="fx-kpi-grid">
        <div class="fx-card fx-kpi fx-card-interactive">
            <div>
                <div class="fx-kpi-label">Spend in range</div>
                <div class="fx-kpi-value">@_d.TotalSpend.ToString("C0")</div>
            </div>
            <div class="fx-kpi-icon"><MudIcon Icon="@Icons.Material.Filled.Payments" /></div>
            <div class="fx-kpi-foot"><strong>@_d.DataMode</strong><span>across selected services</span></div>
        </div>

        <div class="fx-card fx-kpi fx-card-interactive">
            <div>
                <div class="fx-kpi-label">Projected month-end</div>
                <div class="fx-kpi-value">@_d.ProjectedMonthEnd.ToString("C0")</div>
            </div>
            <div class="fx-kpi-icon"><MudIcon Icon="@Icons.Material.Filled.TrendingUp" /></div>
            <div class="fx-kpi-foot">
                <strong class="@(_d.ProjectedMonthEnd > _d.MonthlyBudget && _d.MonthlyBudget > 0 ? "fx-text-danger" : "")">
                    @(_d.MonthlyBudget > 0 ? _d.ProjectedMonthEnd.ToString("C0") + " vs " + _d.MonthlyBudget.ToString("C0") : "no budget set")
                </strong>
                <span>forecast at current run-rate</span>
            </div>
        </div>

        <div class="fx-card fx-kpi fx-card-interactive">
            <div>
                <div class="fx-kpi-label">Budget runway</div>
                <div class="fx-kpi-value">
                    @(_d.DaysUntilBudgetExhausted is { } dx ? (dx <= 0 ? "Over" : $"{dx} days") : "On track")
                </div>
            </div>
            <div class="fx-kpi-icon"><MudIcon Icon="@Icons.Material.Filled.Speed" /></div>
            <div class="fx-kpi-foot">
                <strong>@_d.MonthToDateSpend.ToString("C0")</strong>
                <span>spent of @_d.MonthlyBudget.ToString("C0") this month</span>
            </div>
        </div>

        <div class="fx-card fx-kpi fx-card-interactive">
            <div>
                <div class="fx-kpi-label">Month over month</div>
                <div class="fx-kpi-value @(_d.MoMChangePercent > 0 ? "fx-text-danger" : "fx-text-ok")">
                    @(_d.MoMChangePercent >= 0 ? "+" : "")@_d.MoMChangePercent.ToString("0.#")%
                </div>
            </div>
            <div class="fx-kpi-icon">
                <MudIcon Icon="@(_d.MoMChangePercent >= 0 ? Icons.Material.Filled.NorthEast : Icons.Material.Filled.SouthEast)" />
            </div>
            <div class="fx-kpi-foot"><strong>vs same point last month</strong><span>@_d.PrevMonthSpend.ToString("C0") then</span></div>
        </div>
    </section>

    <!-- Filters (sticky + accordion on mobile) -->
    <section class="fx-card fx-filter-bar @(_filtersOpen ? "is-open" : "is-collapsed")">
        <button type="button" class="fx-filter-toggle" @onclick="@(() => _filtersOpen = !_filtersOpen)">
            <span class="fx-filter-label"><MudIcon Icon="@Icons.Material.Filled.FilterAlt" Size="Size.Small" /> Refine view</span>
            <span class="fx-filter-summary">@FilterSummary</span>
            <MudIcon Icon="@Icons.Material.Filled.ExpandMore" Size="Size.Small" Class="fx-filter-chevron" />
        </button>
        <div class="fx-filter-controls">
            <MudSelect T="string" @bind-Value="_provider" Label="Provider" Dense="true" Class="fx-filter-control">
                <MudSelectItem Value="@("All")">All providers</MudSelectItem>
                <MudSelectItem Value="@("Aws")">AWS</MudSelectItem>
                <MudSelectItem Value="@("Azure")">Azure</MudSelectItem>
                <MudSelectItem Value="@("Gcp")">GCP</MudSelectItem>
            </MudSelect>
            <MudSelect T="int?" @bind-Value="_clientId" Label="Client" Dense="true" Class="fx-filter-control">
                @foreach (var client in _clients)
                {
                    <MudSelectItem T="int?" Value="@client.Id">@client.Name</MudSelectItem>
                }
            </MudSelect>
            <MudDatePicker @bind-Date="_from" Label="From" Class="fx-filter-control" />
            <MudDatePicker @bind-Date="_to" Label="To" Class="fx-filter-control" />
            <MudSpacer />
            <MudButton Class="fx-filter-submit" Variant="Variant.Outlined" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Check" OnClick="LoadAsync">Apply filters</MudButton>
        </div>
    </section>

    <!-- HERO: budget pacing -->
    <section class="fx-card fx-chart-card fx-budget-section">
        <div class="fx-card-head">
            <div>
                <h2 class="fx-card-title">Budget pacing</h2>
                <div class="fx-card-kicker">
                    Spend so far vs the on-budget pace (spending your whole budget evenly across the month).
                    Below the line = under budget — good.
                </div>
            </div>
            <div class="fx-health-chips">
                @if (_d.MonthlyBudget > 0)
                {
                    <span class="fx-health @(_d.PaceVariance <= 0 ? "on" : "over")">
                        @(_d.PaceVariance <= 0
                            ? $"{Math.Abs(_d.PaceVariance).ToString("C0")} under pace"
                            : $"{_d.PaceVariance.ToString("C0")} over pace")
                    </span>
                }
                <span class="fx-health on">@_d.BudgetsOnTrack on track</span>
                <span class="fx-health near">@_d.BudgetsApproaching approaching</span>
                <span class="fx-health over">@_d.BudgetsOver over</span>
            </div>
        </div>
        @if (_d.Pacing.Count > 0 && _d.MonthlyBudget > 0)
        {
            <FxPacingChart Points="_d.Pacing" Budget="_d.MonthlyBudget" />
        }
        else
        {
            <div class="fx-chart-wrap"><Empty Text="Set a project budget and sync costs to see pacing." /></div>
        }
    </section>

    <!-- Budget guardrails table -->
    <section class="fx-card fx-chart-card fx-budget-section">
        <div class="fx-card-head">
            <div>
                <h2 class="fx-card-title">Budget guardrails</h2>
                <div class="fx-card-kicker">Current exposure by project</div>
            </div>
            <div class="fx-card-action"><MudIcon Icon="@Icons.Material.Filled.Shield" Size="Size.Small" /></div>
        </div>
        @if (_d.Budgets.Count > 0)
        {
            <table class="fx-budget-table">
                <thead><tr><th>Project</th><th>Trend</th><th>Budget</th><th>Spend</th><th>Used</th></tr></thead>
                <tbody>
                    @foreach (var row in _d.Budgets)
                    {
                        <tr>
                            <td data-label="Project">@row.Project</td>
                            <td data-label="Trend">
                                @if (_d.ProjectSparklines.TryGetValue(row.ProjectId, out var series) && series.Count > 1)
                                {
                                    <FxSparkline Values="series" Color="@(row.Percent >= 100 ? "#ef4444" : row.Percent >= 80 ? "#f59e0b" : "#10b981")" />
                                }
                                else { <span class="fx-spark-empty">—</span> }
                            </td>
                            <td data-label="Budget">@row.Budget.ToString("C0")</td>
                            <td data-label="Spend">@row.Spend.ToString("C0")</td>
                            <td data-label="Used">
                                <div class="fx-budget-percent">
                                    <MudProgressLinear Color="@(row.Percent >= 100 ? Color.Error : row.Percent >= 80 ? Color.Warning : Color.Success)"
                                                       Value="@Math.Min(row.Percent, 100)" />
                                    <span>@row.Percent%</span>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else { <div class="fx-chart-wrap"><Empty /></div> }
    </section>

    <!-- Provider mix + Top cost drivers -->
    <section class="fx-dashboard-grid">
        <div class="fx-card fx-chart-card">
            <div class="fx-card-head">
                <div><h2 class="fx-card-title">Provider mix</h2><div class="fx-card-kicker">How spend is distributed across clouds</div></div>
                <div class="fx-card-action"><MudIcon Icon="@Icons.Material.Filled.DonutLarge" Size="Size.Small" /></div>
            </div>
            <div class="fx-chart-wrap">
                @if (_d.ByProvider.Any()) { <FxDonutChart Data="_d.ByProvider" /> } else { <Empty /> }
            </div>
        </div>

        <div class="fx-card fx-chart-card">
            <div class="fx-card-head">
                <div><h2 class="fx-card-title">Top cost drivers</h2><div class="fx-card-kicker">Services with the strongest spend signal</div></div>
                <div class="fx-card-action"><MudIcon Icon="@Icons.Material.Filled.Leaderboard" Size="Size.Small" /></div>
            </div>
            <div class="fx-chart-wrap">
                @if (_d.TopServices.Any()) { <FxBarChart Data="_d.TopServices" /> } else { <Empty /> }
            </div>
        </div>
    </section>

    <!-- Top movers + Cost composition -->
    <section class="fx-dashboard-grid">
        <div class="fx-card fx-chart-card">
            <div class="fx-card-head">
                <div><h2 class="fx-card-title">Top movers</h2><div class="fx-card-kicker">Biggest changes vs the previous period</div></div>
                <div class="fx-card-action"><MudIcon Icon="@Icons.Material.Filled.SwapVert" Size="Size.Small" /></div>
            </div>
            <FxDeltaBars Items="_d.TopMovers" />
        </div>

        <div class="fx-card fx-chart-card">
            <div class="fx-card-head">
                <div><h2 class="fx-card-title">Cost composition over time</h2><div class="fx-card-kicker">Daily spend by provider</div></div>
                <div class="fx-card-action"><MudIcon Icon="@Icons.Material.Filled.StackedLineChart" Size="Size.Small" /></div>
            </div>
            @if (_d.Composition.Count > 1) { <FxStackedColumns Days="_d.Composition" Providers="_d.CompositionProviders" /> }
            else { <div class="fx-chart-wrap"><Empty Text="No synced daily data in range." /></div> }
        </div>
    </section>

    <!-- Project budgets: spend vs cap (full width) -->
    <section class="fx-card fx-chart-card">
        <div class="fx-card-head">
            <div><h2 class="fx-card-title">Project budgets</h2><div class="fx-card-kicker">Spend so far vs each project's budget cap</div></div>
            <div class="fx-card-action"><MudIcon Icon="@Icons.Material.Filled.Folder" Size="Size.Small" /></div>
        </div>
        @if (_d.Budgets.Count > 0)
        {
            <div class="fx-pbud">
                @foreach (var b in _d.Budgets.OrderByDescending(x => x.Percent))
                {
                    <div class="fx-pbud-row">
                        <div class="fx-pbud-head">
                            <span class="fx-pbud-name">@b.Project</span>
                            <span class="fx-pbud-nums"><strong>@b.Spend.ToString("C0")</strong> of @b.Budget.ToString("C0")</span>
                        </div>
                        <div class="fx-pbud-track">
                            <div class="fx-pbud-fill @(b.Percent >= 100 ? "over" : b.Percent >= 80 ? "near" : "ok")"
                                 style="width:@Math.Min(b.Percent, 100)%"></div>
                        </div>
                        <div class="fx-pbud-foot">
                            <span class="fx-pbud-pct @(b.Percent >= 100 ? "over" : b.Percent >= 80 ? "near" : "ok")">@b.Percent% used</span>
                            <span>@((b.Budget - b.Spend).ToString("C0")) @(b.Budget - b.Spend >= 0 ? "left" : "over")</span>
                        </div>
                    </div>
                }
            </div>
        }
        else { <div class="fx-chart-wrap"><Empty Text="No budgets set. Add one on a project to track its cap here." /></div> }
    </section>

    <!-- Treemap -->
    <section class="fx-card fx-chart-card">
        <div class="fx-card-head">
            <div><h2 class="fx-card-title">Cost map</h2><div class="fx-card-kicker">Each bar is a service (height = spend), grouped by project; the dot marks its provider (orange AWS · blue Azure · red GCP)</div></div>
            <div class="fx-card-action"><MudIcon Icon="@Icons.Material.Filled.BarChart" Size="Size.Small" /></div>
        </div>
        <FxColumnMap Leaves="_d.Treemap" />
    </section>

    <!-- Spend trend (bottom) with anomaly flags -->
    <section class="fx-card fx-chart-card fx-trend-bottom">
        <div class="fx-card-head">
            <div>
                <h2 class="fx-card-title">Spend trend</h2>
                <div class="fx-card-kicker">
                    Daily spend across the selected range
                    @if (_d.SyncedActualTotal + _d.EstimatedTotal > 0)
                    {
                        <text> · @((int)Math.Round((double)_d.SyncedActualTotal / (double)(_d.SyncedActualTotal + _d.EstimatedTotal) * 100))% synced, rest estimated</text>
                    }
                </div>
            </div>
            <div class="fx-card-action"><MudIcon Icon="@Icons.Material.Filled.ShowChart" Size="Size.Small" /></div>
        </div>
        @if (_d.SpendTrend.Count > 1) { <FxAreaChart Points="_d.SpendTrend" AnomalyIndices="_d.AnomalyIndices" /> }
        else { <div class="fx-chart-wrap"><Empty Text="No daily cost history in range yet — sync a cloud account to populate the trend." /></div> }
    </section>
    </div>
}
else
{
    <div class="fx-card"><div class="fx-chart-wrap"><Empty Text="Loading dashboard…" /></div></div>
}

<div class="fx-ad-slot">Reserved for a privacy-conscious banner on free plans</div>

@code {
    private string _provider = "All";
    private int? _clientId;
    private DateTime? _from = DateTime.Today.AddDays(-30);
    private DateTime? _to = DateTime.Today;
    private bool _syncing;
    private bool _filtersOpen;

    private List<Client> _clients = new();
    private DashboardData? _d;

    private string FilterSummary
    {
        get
        {
            var client = _clients.FirstOrDefault(c => c.Id == _clientId)?.Name ?? "All clients";
            var provider = _provider == "All" ? "All clouds" : _provider;
            return $"{client} · {provider} · {_from:dd MMM} – {_to:dd MMM}";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _clients = await db.Clients.OrderBy(c => c.Name).ToListAsync();
        _clientId ??= _clients.FirstOrDefault()?.Id;   // always keep one client selected
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var from = DateOnly.FromDateTime((_from ?? DateTime.Today.AddDays(-30)).Date);
        var to = DateOnly.FromDateTime((_to ?? DateTime.Today).Date);
        _d = await Analytics.GetAsync(new DashboardQuery(_provider, _clientId, from, to));
        StateHasChanged();
    }

    private async Task RefreshAsync()
    {
        _syncing = true;
        try
        {
            var result = await CostSync.SyncAllAsync(force: true);
            await LoadAsync();

            if (result.Errors.Count > 0)
                Snackbar.Add($"Synced {result.AccountsSucceeded}/{result.AccountsAttempted} accounts. {result.Errors[0]}", Severity.Warning);
            else if (result.AccountsAttempted == 0)
                Snackbar.Add("No connected project services are ready to sync.", Severity.Info);
            else
                Snackbar.Add($"Synced {result.AccountsSucceeded} account(s), updated {result.RecordsWritten} daily cost rows.", Severity.Success);
        }
        finally
        {
            _syncing = false;
        }
    }
}
