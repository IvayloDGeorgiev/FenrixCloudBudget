@page "/"
@inject IDbContextFactory<FenrixCloudBudget.Data.AppDbContext> DbFactory

<h1 class="fx-page-title">Welcome to FenrixCloudBudget</h1>
<p class="fx-page-sub">Group. Budget. Stay ahead — across AWS, Azure & GCP.</p>

<div class="fx-tiles">
    <a class="fx-tile" href="/dashboard">
        <div class="fx-tile-icon"><MudIcon Icon="@Icons.Material.Filled.Dashboard" /></div>
        <div class="fx-tile-title">Dashboard</div>
        <div class="fx-tile-stat">@_monthlySpend.ToString("C0") <small>this month (est.)</small></div>
    </a>
    <a class="fx-tile" href="/projects">
        <div class="fx-tile-icon"><MudIcon Icon="@Icons.Material.Filled.Folder" /></div>
        <div class="fx-tile-title">Projects</div>
        <div class="fx-tile-stat">@_projectCount <small>active</small></div>
    </a>
    <a class="fx-tile" href="/clients">
        <div class="fx-tile-icon"><MudIcon Icon="@Icons.Material.Filled.People" /></div>
        <div class="fx-tile-title">Clients</div>
        <div class="fx-tile-stat">@_clientCount <small>total</small></div>
    </a>
    <a class="fx-tile" href="/reminders">
        <div class="fx-tile-icon"><MudIcon Icon="@Icons.Material.Filled.Alarm" /></div>
        <div class="fx-tile-title">Reminders</div>
        <div class="fx-tile-stat">@_remindersDue <small>due soon</small></div>
    </a>
    <a class="fx-tile" href="/cloud-services">
        <div class="fx-tile-icon"><MudIcon Icon="@Icons.Material.Filled.Cloud" /></div>
        <div class="fx-tile-title">Cloud Services</div>
        <div class="fx-tile-stat">@_accountCount <small>connected</small></div>
    </a>
    <a class="fx-tile" href="/settings">
        <div class="fx-tile-icon"><MudIcon Icon="@Icons.Material.Filled.Settings" /></div>
        <div class="fx-tile-title">Settings</div>
        <div class="fx-tile-stat" style="font-size:16px">Theme · Data · Email</div>
    </a>
</div>

@code {
    private decimal _monthlySpend;
    private int _projectCount, _clientCount, _remindersDue, _accountCount;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _projectCount = await db.Projects.CountAsync(p => p.Status == ProjectStatus.Active);
        _clientCount = await db.Clients.CountAsync();
        _accountCount = await db.CloudAccounts.CountAsync();

        var soon = DateTimeOffset.UtcNow.AddDays(14);
        _remindersDue = await db.Reminders.CountAsync(r => r.Status == ReminderStatus.Active && r.DueDate <= soon);

        // Monthly estimate from manual service costs (synced actuals refine this in Phase 4).
        _monthlySpend = await db.Services.SumAsync(s => (decimal?)s.EstimatedCost) ?? 0m;
    }
}
