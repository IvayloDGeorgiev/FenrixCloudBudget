@page "/settings"
@inject ThemeService Theme
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IEmailSenderFactory EmailFactory
@inject ISecretStore Secrets
@inject FenrixCloudBudget.Data.TestData.TestDataState TestData
@inject FenrixCloudBudget.Data.TestData.RoutingDbContextFactory TestRouting
@inject ISnackbar Snackbar

<section class="fx-page-header">
    <div class="fx-page-heading">
        <div class="fx-eyebrow">Workspace preferences</div>
        <h1 class="fx-page-title">Settings</h1>
        <p class="fx-page-sub">Shape the workspace, choose where data lives and configure how Fenrix reaches you.</p>
    </div>
</section>

<div class="fx-card fx-settings-card">
    <MudTabs Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-5">
        <MudTabPanel Text="Appearance" Icon="@Icons.Material.Filled.Palette">
            <div class="fx-appearance-intro">
                <div>
                    <h3>Choose a visual personality</h3>
                    <p>
                        Each personality changes the atmosphere, navigation, geometry, surface depth
                        and component palette. It is a full design language—not a simple colour swap.
                    </p>
                </div>
                <div class="fx-motion-badge">
                    <MudIcon Icon="@Icons.Material.Filled.Animation" Size="Size.Small" />
                    Motion follows system accessibility settings
                </div>
            </div>

            <div class="fx-theme-gallery">
                @foreach (var theme in ThemeService.Available)
                {
                    var selected = Theme.CurrentThemeId == theme.Id;
                    <button type="button"
                            class="fx-theme-choice @(selected ? "selected" : "")"
                            style="@PreviewStyle(theme)"
                            aria-pressed="@selected"
                            @onclick="@(() => ChooseThemeAsync(theme.Id))">
                        @if (selected)
                        {
                            <span class="fx-theme-check"><MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" /></span>
                        }

                        <span class="fx-theme-preview" aria-hidden="true">
                            <span class="fx-theme-preview-nav"></span>
                            <span class="fx-theme-preview-body">
                                <span class="fx-preview-heading"></span>
                                <span class="fx-preview-kpis"><span></span><span></span><span></span></span>
                                <span class="fx-preview-chart"></span>
                            </span>
                        </span>

                        <span class="fx-theme-copy">
                            <span class="fx-theme-name-row">
                                <strong>@theme.Name</strong>
                                <span class="fx-theme-mode">@(theme.Dark ? "Dark" : "Light")</span>
                            </span>
                            <p>@theme.Description</p>
                            <span class="fx-theme-personality">@theme.Personality</span>
                            <span class="fx-theme-swatches" aria-hidden="true">
                                <span style="background:@theme.Primary"></span>
                                <span style="background:@theme.Secondary"></span>
                                <span style="background:@theme.Accent"></span>
                            </span>
                        </span>
                    </button>
                }
            </div>
        </MudTabPanel>

        <MudTabPanel Text="Data & connections" Icon="@Icons.Material.Filled.Storage">
            <div class="fx-appearance-intro">
                <div>
                    <h3>Storage backend</h3>
                    <p>SQLite stays on-device by default. Server modes place the workspace in a central data store.</p>
                </div>
            </div>

            <div class="fx-card mt-3" style="background:var(--fx-surface-2);box-shadow:none">
                <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:16px">
                    <div>
                        <strong>Test data mode</strong>
                        <MudText Typo="Typo.caption">
                            When on, the whole app shows an isolated sample dataset (5 demo clients with
                            projects, services, budgets and ~30 days of cost history) instead of your real
                            data — even when a database is connected. Your real data is never touched; turn
                            this off to return to it. Great for trying features quickly.
                        </MudText>
                    </div>
                    <MudSwitch T="bool" Value="_testDataEnabled" ValueChanged="OnTestDataChanged" Color="Color.Primary" />
                </div>
                @if (_testDataEnabled)
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
                        Showing seeded test data. Navigate between pages (or reopen one) to refresh the view.
                    </MudAlert>
                }
            </div>

            @if (_settings is not null)
            {
                <div class="fx-settings-form">
                    <MudSelect T="DataProviderMode" @bind-Value="_settings.DataMode" Label="Storage mode" Class="mt-2">
                        <MudSelectItem Value="DataProviderMode.Sqlite">SQLite — on-device</MudSelectItem>
                        <MudSelectItem Value="DataProviderMode.SqlServer">SQL Server</MudSelectItem>
                        <MudSelectItem Value="DataProviderMode.CloudSql">Cloud SQL / Azure SQL</MudSelectItem>
                        <MudSelectItem Value="DataProviderMode.Saas">FenrixCloud — SaaS</MudSelectItem>
                    </MudSelect>

                    @if (_settings.DataMode is DataProviderMode.SqlServer or DataProviderMode.CloudSql)
                    {
                        <MudTextField @bind-Value="_connectionString" Label="Connection string" Class="mt-3" />
                        <MudButton Variant="Variant.Outlined" Class="mt-2" OnClick="TestConnection">Test connection</MudButton>
                        <MudText Typo="Typo.caption" Class="mt-1">@_testResult</MudText>
                    }

                    <div class="mt-5">
                        <MudNumericField @bind-Value="_settings.SyncIntervalHours"
                                         Label="Automatic sync interval (hours)"
                                         Class="fx-settings-number" />
                        <MudText Typo="Typo.caption">
                            A calmer interval reduces provider API traffic. AWS Cost Explorer charges per request.
                        </MudText>
                    </div>

                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4"
                               StartIcon="@Icons.Material.Filled.Save"
                               OnClick="SaveSettings">
                        Save data settings
                    </MudButton>
                </div>
            }
        </MudTabPanel>

        <MudTabPanel Text="Emails & Notifications" Icon="@Icons.Material.Filled.MarkEmailRead">
            <div class="fx-appearance-intro">
                <div>
                    <h3>Email & notifications</h3>
                    <p>Choose one delivery method. Sensitive values are encrypted and represented by a masked hint.</p>
                </div>
            </div>

            @if (_email is not null)
            {
                <div class="fx-settings-form">
                    <MudSelect T="EmailMethod" @bind-Value="_email.Method" Label="Delivery method" Class="mt-2">
                        <MudSelectItem Value="EmailMethod.InAppAndDeviceOnly">In-app & device only</MudSelectItem>
                        <MudSelectItem Value="EmailMethod.CustomSmtp">Custom SMTP</MudSelectItem>
                        <MudSelectItem Value="EmailMethod.Resend">Resend</MudSelectItem>
                        <MudSelectItem Value="EmailMethod.SendGrid">SendGrid</MudSelectItem>
                        <MudSelectItem Value="EmailMethod.AmazonSes">Amazon SES</MudSelectItem>
                        <MudSelectItem Value="EmailMethod.Postmark">Postmark</MudSelectItem>
                        <MudSelectItem Value="EmailMethod.AzureCommunicationServices">Azure Communication Services</MudSelectItem>
                    </MudSelect>

                    @{
                        var schema = EmailFactory.Resolve(_email.Method).FieldSchema;
                    }
                    @if (schema.Count == 0)
                    {
                        <div class="fx-card mt-4" style="background:var(--fx-surface-2);box-shadow:none">
                            Alerts will stay inside the app and use local device notifications.
                        </div>
                    }
                    else
                    {
                        <div class="mt-3">
                            @foreach (var field in schema)
                            {
                                <MudTextField T="string"
                                              Label="@(field.Label + (field.Required ? " *" : ""))"
                                              InputType="@(field.IsSecret ? InputType.Password : InputType.Text)"
                                              Placeholder="@FieldPlaceholder(field)"
                                          HelperText="@FieldHelp(field)"
                                              Value="@GetField(field.Key)"
                                              ValueChanged="value => SetField(field.Key, value)" />
                            }
                        </div>
                        <MudButton Variant="Variant.Outlined" Class="mt-3"
                                   StartIcon="@Icons.Material.Filled.Send"
                                   OnClick="SendTest">
                            Send test email
                        </MudButton>
                    }

                    <div class="fx-settings-actions mt-4">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Save"
                                   OnClick="SaveEmail">
                            Save notification settings
                        </MudButton>
                        <MudChip T="string"
                                 Color="@(_email.Status == EmailConfigStatus.Verified ? Color.Success : _email.Status == EmailConfigStatus.Failed ? Color.Error : Color.Default)">
                            @_email.Status
                        </MudChip>
                    </div>
                </div>
            }
        </MudTabPanel>
    </MudTabs>
</div>

@code {
    private AppSetting? _settings;
    private EmailConfig? _email;
    private string _connectionString = "";
    private string _testResult = "";
    private bool _testDataEnabled;
    private readonly Dictionary<string, string> _fields = new();

    protected override async Task OnInitializedAsync()
    {
        _testDataEnabled = TestData.Enabled;
        await using var db = await DbFactory.CreateDbContextAsync();
        _settings = await db.AppSettings.FirstOrDefaultAsync() ?? new AppSetting();
        _settings.ThemeId = ThemeService.ResolveThemeId(_settings.ThemeId);
        Theme.SetTheme(_settings.ThemeId);
        _email = await db.EmailConfigs.FirstOrDefaultAsync() ?? new EmailConfig();

        // Prefill the non-secret fields so returning to Settings shows what's saved. Secret
        // fields stay blank (they're never round-tripped); the saved hint is shown as a placeholder.
        if (!string.IsNullOrWhiteSpace(_email.OptionsJson))
        {
            var saved = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, string>>(_email.OptionsJson);
            if (saved is not null)
                foreach (var kv in saved)
                    _fields[kv.Key] = kv.Value;
        }
        if (!string.IsNullOrWhiteSpace(_email.FromAddress))
            _fields["fromAddress"] = _email.FromAddress;
    }

    private async Task OnTestDataChanged(bool value)
    {
        _testDataEnabled = value;
        if (value)
            await TestRouting.EnsureTestReadyAsync();   // create + seed the isolated test DB on first use
        TestData.Set(value);                            // flips what every page reads; host persists it
        Snackbar.Add(
            value
                ? "Test data ON — showing seeded sample data. Navigate to refresh views."
                : "Test data OFF — showing your real data.",
            Severity.Info);
    }

    private string GetField(string key) => _fields.GetValueOrDefault(key, "");
    private void SetField(string key, string value) => _fields[key] = value;

    private async Task ChooseThemeAsync(string themeId)
    {
        Theme.SetTheme(themeId);
        _settings ??= new AppSetting();
        _settings.ThemeId = themeId;

        await using var db = await DbFactory.CreateDbContextAsync();
        if (_settings.Id == 0)
            db.AppSettings.Add(_settings);
        else
            db.AppSettings.Update(_settings);
        await db.SaveChangesAsync();
    }

    private static string PreviewStyle(ThemeService.ThemeInfo theme) => theme.Id switch
    {
        "nebula" =>
            $"--preview-bg:#080B16;--preview-nav:#0C1120;--preview-surface:#151C31;--preview-text:#F5F7FF;--preview-border:#2A3450;--preview-primary:{theme.Primary};--preview-secondary:{theme.Secondary};--preview-gradient:linear-gradient(135deg,{theme.Primary},{theme.Secondary})",
        "graphite" =>
            $"--preview-bg:#0D0F12;--preview-nav:#101216;--preview-surface:#191D23;--preview-text:#F4F6F8;--preview-border:#303640;--preview-primary:{theme.Primary};--preview-secondary:{theme.Secondary};--preview-gradient:linear-gradient(135deg,{theme.Primary},{theme.Secondary})",
        "tide" =>
            $"--preview-bg:#EEF6F7;--preview-nav:#12343B;--preview-surface:#FAFDFD;--preview-text:#102F36;--preview-border:#CFE0E2;--preview-primary:{theme.Primary};--preview-secondary:{theme.Secondary};--preview-gradient:linear-gradient(135deg,{theme.Primary},{theme.Secondary})",
        _ =>
            $"--preview-bg:#F4F5FB;--preview-nav:#11152A;--preview-surface:#FFFFFF;--preview-text:#171A2B;--preview-border:#E3E5F0;--preview-primary:{theme.Primary};--preview-secondary:{theme.Secondary};--preview-gradient:linear-gradient(135deg,{theme.Primary},{theme.Secondary})"
    };

    private async Task SaveSettings()
    {
        if (_settings is null)
            return;

        _settings.ThemeId = Theme.CurrentThemeId;
        await using var db = await DbFactory.CreateDbContextAsync();
        if (_settings.Id == 0)
            db.AppSettings.Add(_settings);
        else
            db.AppSettings.Update(_settings);
        await db.SaveChangesAsync();
        Snackbar.Add("Data settings saved", Severity.Success);
    }

    private void TestConnection() =>
        _testResult = "The desktop host validates the live provider when these settings are saved.";

    private string? FieldPlaceholder(EmailFieldSpec field)
        => field.IsSecret && !string.IsNullOrWhiteSpace(_email?.SecretHint)
            ? _email!.SecretHint
            : field.Placeholder;

    private string? FieldHelp(EmailFieldSpec field)
    {
        if (!field.IsSecret)
            return null;
        return !string.IsNullOrWhiteSpace(_email?.SecretHint)
            ? "Encrypted at rest. Leave blank to keep the saved key."
            : "Encrypted at rest; masked after save.";
    }

    /// <summary>
    /// Persist the email config, encrypting any newly entered secret via the secret store and
    /// storing all non-secret schema fields. Returns false if a required value is missing.
    /// </summary>
    private async Task<bool> PersistEmailAsync()
    {
        if (_email is null)
            return false;

        var schema = EmailFactory.Resolve(_email.Method).FieldSchema;
        var nonSecretKeys = schema.Where(f => !f.IsSecret).Select(f => f.Key).ToHashSet();

        // Store every non-secret field the active method declares (fromAddress, host, region, …).
        _email.OptionsJson = System.Text.Json.JsonSerializer.Serialize(
            _fields.Where(kv => nonSecretKeys.Contains(kv.Key) && !string.IsNullOrWhiteSpace(kv.Value))
                   .ToDictionary(kv => kv.Key, kv => kv.Value));
        _email.FromAddress = _fields.GetValueOrDefault("fromAddress");

        // A bare domain (e.g. "yourdomain.com") is rejected by every provider — require a full
        // mailbox address. The mailbox need not exist; the domain just has to be verified.
        if (schema.Any(f => f.Key == "fromAddress")
            && (string.IsNullOrWhiteSpace(_email.FromAddress)
                || !System.Net.Mail.MailAddress.TryCreate(_email.FromAddress, out _)))
        {
            Snackbar.Add("Enter a full From address like no-reply@yourdomain.com (a bare domain won't work).", Severity.Warning);
            return false;
        }

        // Secret round-trip: encrypt a newly entered secret; if left blank, keep the saved one.
        var secretField = schema.FirstOrDefault(f => f.IsSecret);
        if (secretField is null)
        {
            _email.CredentialReference = null;
            _email.SecretHint = null;
        }
        else
        {
            var entered = _fields.GetValueOrDefault(secretField.Key);
            if (!string.IsNullOrWhiteSpace(entered))
            {
                var handle = await Secrets.SaveAsync(entered.Trim());
                _email.CredentialReference = handle.Reference;
                _email.SecretHint = handle.Hint;
            }
            else if (string.IsNullOrWhiteSpace(_email.CredentialReference))
            {
                Snackbar.Add($"Enter the {secretField.Label.ToLowerInvariant()} before saving.", Severity.Warning);
                return false;
            }
        }

        _email.Enabled = _email.Method != EmailMethod.InAppAndDeviceOnly;

        await using var db = await DbFactory.CreateDbContextAsync();
        if (_email.Id == 0)
            db.EmailConfigs.Add(_email);
        else
            db.EmailConfigs.Update(_email);
        await db.SaveChangesAsync();
        return true;
    }

    private async Task SaveEmail()
    {
        if (await PersistEmailAsync())
            Snackbar.Add("Notification settings saved", Severity.Success);
    }

    private async Task SendTest()
    {
        if (_email is null)
            return;

        // Save first so the adapter reads the just-entered key from secure storage.
        if (!await PersistEmailAsync())
            return;

        var result = await EmailFactory.Resolve(_email.Method)
            .SendTestAsync(_email.FromAddress ?? "test@example.com");
        _email.Status = result.Success ? EmailConfigStatus.Verified : EmailConfigStatus.Failed;

        await using var db = await DbFactory.CreateDbContextAsync();
        db.EmailConfigs.Update(_email);
        await db.SaveChangesAsync();

        Snackbar.Add(
            result.Success ? "Test sent" : $"Failed: {result.Error}",
            result.Success ? Severity.Success : Severity.Error);
    }
}
