@inherits LayoutComponentBase
@inject ThemeService Theme
@inject AuthSessionService Auth
@inject IJSRuntime JS
@inject IDbContextFactory<AppDbContext> DbFactory
@implements IDisposable

<div class="fx-app-background" aria-hidden="true">
    <div class="fx-ambient-orb fx-orb-one"></div>
    <div class="fx-ambient-orb fx-orb-two"></div>
    <div class="fx-grid-wash"></div>
</div>

<div class="fx-shell">
    <NavMenu />
    <div class="fx-workspace">
        <header class="fx-topbar">
            <div class="fx-topbar-context">
                <span class="fx-live-dot"></span>
                <span>FinOps workspace</span>
            </div>
            <div class="fx-topbar-actions">
                <a class="fx-command-pill" href="/settings">
                    <span class="fx-theme-swatch" style="background:var(--fx-gradient)"></span>
                    <span class="fx-command-label">@Theme.Current.Name</span>
                </a>
                <button type="button" class="fx-session-pill" title="Sign out" @onclick="Auth.Logout">
                    <span class="fx-avatar">@Initials()</span>
                    <span class="fx-session-copy">
                        <strong>@(Auth.CurrentUser?.DisplayName ?? "Workspace user")</strong>
                        <small>@Auth.CurrentUser?.Role · Sign out</small>
                    </span>
                    <MudIcon Icon="@Icons.Material.Filled.Logout" Size="Size.Small" />
                </button>
            </div>
        </header>

        <main class="fx-main">
            <h1 style="display:none">FenrixCloudBudget</h1>
            <div class="fx-page-enter">
                @Body
            </div>
        </main>
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        Theme.Changed += OnThemeChanged;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var savedTheme = await db.AppSettings.Select(setting => setting.ThemeId).FirstOrDefaultAsync();
            Theme.SetTheme(savedTheme);
        }
        catch
        {
            // The database can still be migrating during the first frame; the default theme is safe.
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await ApplyThemeAsync();
    }

    private async void OnThemeChanged()
    {
        await ApplyThemeAsync();
        await InvokeAsync(StateHasChanged);
    }

    private Task ApplyThemeAsync()
        => JS.InvokeVoidAsync(
            "document.documentElement.setAttribute",
            "data-theme",
            Theme.CurrentThemeId).AsTask();

    private string Initials()
    {
        var source = Auth.CurrentUser?.DisplayName ?? Auth.CurrentUser?.Email ?? "User";
        var words = source.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return words.Length > 1
            ? string.Concat(words.Take(2).Select(word => char.ToUpperInvariant(word[0])))
            : source[..Math.Min(2, source.Length)].ToUpperInvariant();
    }

    public void Dispose() => Theme.Changed -= OnThemeChanged;
}
