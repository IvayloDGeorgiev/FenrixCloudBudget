@inject AuthSessionService Auth
@implements IDisposable

<nav class="fx-nav" aria-label="Primary navigation">
    <a class="fx-nav-brand" href="/">
        <span class="fx-brand-mark" aria-hidden="true">
            <span class="fx-brand-cloud"></span>
            <span class="fx-brand-spark"></span>
        </span>
        <span class="fx-brand-copy">
            <strong>Fenrix</strong>
            <small>CloudBudget</small>
        </span>
    </a>

    <div class="fx-nav-section">
        <div class="fx-nav-label">Workspace</div>
        <NavLink class="fx-nav-link" href="/" Match="NavLinkMatch.All">
            <span class="fx-nav-icon"><MudIcon Icon="@Icons.Material.Filled.Home" Size="Size.Small" /></span>
            <span>Overview</span>
        </NavLink>
        <NavLink class="fx-nav-link" href="/dashboard">
            <span class="fx-nav-icon"><MudIcon Icon="@Icons.Material.Filled.SpaceDashboard" Size="Size.Small" /></span>
            <span>Dashboard</span>
        </NavLink>
        <NavLink class="fx-nav-link" href="/projects">
            <span class="fx-nav-icon"><MudIcon Icon="@Icons.Material.Filled.FolderOpen" Size="Size.Small" /></span>
            <span>Projects</span>
        </NavLink>
        <NavLink class="fx-nav-link" href="/clients">
            <span class="fx-nav-icon"><MudIcon Icon="@Icons.Material.Filled.Groups" Size="Size.Small" /></span>
            <span>Clients</span>
        </NavLink>
    </div>

    <div class="fx-nav-section">
        <div class="fx-nav-label">Operations</div>
        <NavLink class="fx-nav-link" href="/reminders">
            <span class="fx-nav-icon"><MudIcon Icon="@Icons.Material.Filled.NotificationsActive" Size="Size.Small" /></span>
            <span>Reminders</span>
        </NavLink>
        <NavLink class="fx-nav-link" href="/cloud-services">
            <span class="fx-nav-icon"><MudIcon Icon="@Icons.Material.Filled.CloudQueue" Size="Size.Small" /></span>
            <span>Cloud services</span>
        </NavLink>
        @if (Auth.IsAdmin)
        {
            <NavLink class="fx-nav-link" href="/users">
                <span class="fx-nav-icon"><MudIcon Icon="@Icons.Material.Filled.ManageAccounts" Size="Size.Small" /></span>
                <span>Users</span>
            </NavLink>
        }
    </div>

    <div class="fx-nav-spacer"></div>

    <a class="fx-nav-insight" href="/dashboard">
        <span class="fx-insight-icon"><MudIcon Icon="@Icons.Material.Filled.AutoGraph" /></span>
        <span>
            <strong>Cost intelligence</strong>
            <small>Live sync is ready</small>
        </span>
        <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" />
    </a>

    <NavLink class="fx-nav-link fx-settings-link" href="/settings">
        <span class="fx-nav-icon"><MudIcon Icon="@Icons.Material.Filled.Tune" Size="Size.Small" /></span>
        <span>Settings</span>
    </NavLink>

    <div class="fx-nav-foot">
        <span class="fx-status-pulse"></span>
        <span>@(Auth.IsAdmin ? "Admin session" : "Member session")</span>
        <small>v0.1</small>
    </div>
</nav>

@code {
    protected override void OnInitialized() => Auth.Changed += OnAuthChanged;
    private void OnAuthChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Auth.Changed -= OnAuthChanged;
}
