@*
   Side navigation. Mirrors the landing tiles: Dashboard, Projects, Clients, Reminders,
   Cloud Services, Users, Settings. Restyled with design tokens (not default chrome).
*@
<nav class="fx-nav">
    <div class="fx-nav-brand">
        <span>Fenrix</span>CloudBudget
    </div>

    <NavLink class="fx-nav-link" href="/" Match="NavLinkMatch.All">
        <MudIcon Icon="@Icons.Material.Filled.Home" Size="Size.Small" /> Home
    </NavLink>
    <NavLink class="fx-nav-link" href="/dashboard">
        <MudIcon Icon="@Icons.Material.Filled.Dashboard" Size="Size.Small" /> Dashboard
    </NavLink>
    <NavLink class="fx-nav-link" href="/projects">
        <MudIcon Icon="@Icons.Material.Filled.Folder" Size="Size.Small" /> Projects
    </NavLink>
    <NavLink class="fx-nav-link" href="/clients">
        <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Small" /> Clients
    </NavLink>
    <NavLink class="fx-nav-link" href="/reminders">
        <MudIcon Icon="@Icons.Material.Filled.Alarm" Size="Size.Small" /> Reminders
    </NavLink>
    <NavLink class="fx-nav-link" href="/cloud-services">
        <MudIcon Icon="@Icons.Material.Filled.Cloud" Size="Size.Small" /> Cloud Services
    </NavLink>
    <NavLink class="fx-nav-link" href="/users">
        <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" Size="Size.Small" /> Users
    </NavLink>
    <NavLink class="fx-nav-link" href="/settings">
        <MudIcon Icon="@Icons.Material.Filled.Settings" Size="Size.Small" /> Settings
    </NavLink>
</nav>

<style>
    .fx-nav {
        width: 232px; flex-shrink: 0; padding: 18px 12px;
        background: var(--fx-surface); border-right: 1px solid var(--fx-border);
        display: flex; flex-direction: column; gap: 4px; position: sticky; top: 0; height: 100vh; box-sizing: border-box;
    }
    .fx-nav-brand { font-weight: 800; font-size: 18px; padding: 8px 12px 16px; }
    .fx-nav-brand span { color: var(--fx-primary); }
    .fx-nav-link {
        display: flex; align-items: center; gap: 10px;
        padding: 10px 12px; border-radius: var(--fx-radius-sm);
        color: var(--fx-text); text-decoration: none; font-size: 14px; font-weight: 500;
    }
    .fx-nav-link:hover { background: var(--fx-surface-2); }
    .fx-nav-link.active { background: color-mix(in srgb, var(--fx-primary) 14%, transparent); color: var(--fx-primary); }
    @@media (max-width: 640px) {
        .fx-nav { width: 64px; }
        .fx-nav-brand, .fx-nav-link { font-size: 0; justify-content: center; }
    }
</style>
