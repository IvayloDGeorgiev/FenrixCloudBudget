@using System.Globalization
@using FenrixCloudBudget.Services.Analytics
@*
   Stacked area showing daily spend split by provider — total trend plus shifting mix.
   Reveals left-to-right. Pure SVG + CSS.
*@

<div class="fx-stack">
    <div class="fx-stack-plot @(_mounted ? "is-revealed" : "")">
        <svg viewBox="0 0 100 100" preserveAspectRatio="none" class="fx-stack-svg" aria-hidden="true">
            @foreach (var layer in _layers)
            {
                <path d="@layer.Path" fill="@layer.Color"
                      fill-opacity="@(_hover is null || _hover == layer.Provider ? "0.88" : "0.25")"
                      style="transition:fill-opacity .2s ease" />
            }
        </svg>
    </div>
    <div class="fx-stack-legend">
        @foreach (var p in Providers)
        {
            <span class="fx-stack-leg @(_hover == p ? "is-hover" : "")"
                  @onmouseover="@(() => _hover = p)" @onmouseout="@(() => _hover = null)">
                <i class="fx-stack-dot" style="background:@Color(p)"></i> @p
            </span>
        }
    </div>
</div>

@code {
    [Parameter] public IReadOnlyList<CompositionDay> Days { get; set; } = Array.Empty<CompositionDay>();
    [Parameter] public IReadOnlyList<string> Providers { get; set; } = Array.Empty<string>();

    private bool _mounted;
    private string? _hover;
    private List<Layer> _layers = new();
    private record Layer(string Provider, string Color, string Path);

    protected override void OnParametersSet()
    {
        var n = Days.Count;
        _layers = new();
        if (n < 2 || Providers.Count == 0) return;

        var max = Math.Max(1, Days.Max(d => Providers.Sum(p => d.ByProvider.GetValueOrDefault(p))));
        double X(int i) => (double)i / (n - 1) * 100;
        double Y(double v) => 100 - v / max * 98;

        // Stack bottom-up; each layer polygon = top edge forward + previous cumulative edge backward.
        var cumulative = new double[n];
        foreach (var provider in Providers)
        {
            var top = new (double X, double Y)[n];
            var bottom = new (double X, double Y)[n];
            for (var i = 0; i < n; i++)
            {
                var v = Days[i].ByProvider.GetValueOrDefault(provider);
                bottom[i] = (X(i), Y(cumulative[i]));
                cumulative[i] += v;
                top[i] = (X(i), Y(cumulative[i]));
            }
            var bottomRev = bottom.Reverse().ToList();
            var path = "M" + $"{F(top[0].X)},{F(top[0].Y)}" + SmoothCont(top)
                     + $" L{F(bottomRev[0].X)},{F(bottomRev[0].Y)}" + SmoothCont(bottomRev) + " Z";
            _layers.Add(new Layer(provider, Color(provider), path));
        }
    }

    /// <summary>Catmull-Rom bezier segments (no leading move) so two smoothed edges share endpoints.</summary>
    private static string SmoothCont(IReadOnlyList<(double X, double Y)> p)
    {
        if (p.Count < 2) return "";
        if (p.Count < 3) return " L" + string.Join(" L", p.Skip(1).Select(q => $"{F(q.X)},{F(q.Y)}"));
        var sb = new System.Text.StringBuilder();
        for (var i = 0; i < p.Count - 1; i++)
        {
            var p0 = p[Math.Max(0, i - 1)];
            var p1 = p[i];
            var p2 = p[i + 1];
            var p3 = p[Math.Min(p.Count - 1, i + 2)];
            var c1x = p1.X + (p2.X - p0.X) / 6.0;
            var c1y = p1.Y + (p2.Y - p0.Y) / 6.0;
            var c2x = p2.X - (p3.X - p1.X) / 6.0;
            var c2y = p2.Y - (p3.Y - p1.Y) / 6.0;
            sb.Append($" C{F(c1x)},{F(c1y)} {F(c2x)},{F(c2y)} {F(p2.X)},{F(p2.Y)}");
        }
        return sb.ToString();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_mounted) { _mounted = true; await Task.Delay(60); StateHasChanged(); }
    }

    private static string Color(string provider) => provider.ToLowerInvariant() switch
    {
        "aws" => "var(--fx-aws)",
        "azure" => "var(--fx-azure)",
        "gcp" => "var(--fx-gcp)",
        _ => "var(--fx-primary)"
    };

    private static string F(double v) => v.ToString("0.###", CultureInfo.InvariantCulture);
}

<style>
    .fx-stack { width: 100%; }
    .fx-stack-plot { width: 100%; height: 230px; }
    .fx-stack-svg { width: 100%; height: 100%; display: block;
        clip-path: inset(0 100% 0 0); transition: clip-path 1.1s cubic-bezier(.22,1,.36,1); }
    .fx-stack-plot.is-revealed .fx-stack-svg { clip-path: inset(0 0 0 0); }
    .fx-stack-legend { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 12px; font-size: 12px; color: var(--fx-text-muted); }
    .fx-stack-legend span { display: inline-flex; align-items: center; gap: 6px; }
    .fx-stack-leg { cursor: pointer; padding: 2px 8px; border-radius: 999px; transition: background .15s ease; }
    .fx-stack-leg.is-hover { background: var(--fx-surface-2); color: var(--fx-text); }
    .fx-stack-dot { width: 11px; height: 11px; border-radius: 3px; display: inline-block; }
</style>
